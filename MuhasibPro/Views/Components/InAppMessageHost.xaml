<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.Components.InAppMessageHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  Uygulama içi bildirim host'u (InfoBar). Boşken hiç yer kaplamaz.  -->
    <ItemsControl ItemsSource="{x:Bind Mesajlar, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <InfoBar
                    Margin="0,0,0,8"
                    IsClosable="True"
                    IsOpen="True"
                    Message="{Binding Mesaj}"
                    Severity="{Binding Tur, Converter={StaticResource NotificationTypeToInfoBarSeverityConverter}}"
                    Title="{Binding Baslik}"
                    CloseButtonClick="OnCloseButtonClick" />
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
