<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MuhasibPro.Views.ShellViews.Splash.ExtendedSplash"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MuhasibPro.Views.ShellViews.Splash"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnPageLoaded"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <!-- Kart giriş animasyonu -->
        <Storyboard x:Name="CardEntranceStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="SplashCard"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="CardTransform"
                Storyboard.TargetProperty="Y"
                From="12" To="0" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid x:Name="SplashOverlay" Background="{ThemeResource AppBackgroundBrush}">

        <!-- Buzlu anakart (Invent: beyaz iç kartlar üstte yüzer) -->
        <Border
            x:Name="SplashCard"
            Width="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Translation="0,0,32"
            Style="{StaticResource CustomElevatedCard}">
            <Border.Shadow>
                <ThemeShadow x:Name="CardShadow" />
            </Border.Shadow>
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTransform" />
            </Border.RenderTransform>

            <StackPanel Spacing="16">

                <!-- Logo + başlık -->
                <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,4">
                    <Border Width="56" Height="56" CornerRadius="{StaticResource MuhasibCardCornerRadius}" HorizontalAlignment="Center"
                            Background="{StaticResource MuhasibPetrolBrush}">
                        <TextBlock Text="M" FontSize="28" FontWeight="Bold" Foreground="{StaticResource MuhasibOnPetrolBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource MuhasibTextPrimaryBrush}"
                        Text="MuhasibPro" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontSize="13"
                        Foreground="{StaticResource MuhasibSageTertiaryBrush}"
                        Text="Yeni Nesil Ön Muhasebe" />
                </StackPanel>

                <!-- Durum yazısı (buz üstünde çıplak — animasyonlu metne beyaz hub yok) -->
                <local:SplashStatusControl x:Name="StatusControl" />

                <!-- Progress kartı -->
                <Border Style="{StaticResource InventCardStyle}" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Padding="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            x:Name="progress"
                            Grid.Column="0"
                            Height="6"
                            VerticalAlignment="Center"
                            Background="{StaticResource MuhasibSoftBorderBrush}"
                            Foreground="{StaticResource MuhasibPetrolBrush}"
                            Maximum="100"
                            Value="{x:Bind ProgressValue, Mode=OneWay}" />
                        <Border Grid.Column="1"
                                Padding="12,5" CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                                Background="{StaticResource MuhasibPetrolTintBrush}"
                                BorderBrush="{StaticResource MuhasibPetrolBorderBrush}" BorderThickness="1">
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource MuhasibPetrolDeepBrush}" HorizontalAlignment="Center">
                                <Run Text="{x:Bind ProgressValue, Mode=OneWay}" />
                                <Run Text="%" />
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <!-- Sistem rozeti (buz üstünde beyaz hap) -->
                <Border
                    Padding="10,6"
                    CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                    HorizontalAlignment="Center"
                    Background="{StaticResource MuhasibInventCardBrush}"
                    BorderBrush="{StaticResource MuhasibSoftBorderBrush}"
                    BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            Glyph="{StaticResource IconDatabase}"
                            FontSize="11"
                            Foreground="{StaticResource MuhasibSageTertiaryBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="SQLite WAL • Multi-Tenant"
                            FontSize="10"
                            Foreground="{StaticResource MuhasibSageTertiaryBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Footer — sürüm / telif -->
        <Grid Padding="24,0,24,14" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                HorizontalAlignment="Left"
                FontSize="10"
                Foreground="{StaticResource MuhasibSageTertiaryBrush}"
                Opacity="0.5"
                Text="{x:Bind Version}" />
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                FontSize="10"
                Foreground="{StaticResource MuhasibSageTertiaryBrush}"
                Opacity="0.5"
                Text="{x:Bind CopyrightText}" />
        </Grid>
    </Grid>
</Page>
