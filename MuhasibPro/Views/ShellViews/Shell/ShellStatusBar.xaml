<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.ShellViews.Shell.ShellStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  Fluent durum çubuğu (footer): sol = durum + progress, sağ = kullanıcı · sistem DB · saat  -->
    <Grid
        x:Name="StatusBar"
        Height="30"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Sol — durum mesajı + progress  -->
        <StackPanel
            Grid.Column="0"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">

            <!--  Severity ikonu (tema-reaktif; renk View'da, servis renk bilmez)  -->
            <Grid
                Width="16"
                Height="16"
                VerticalAlignment="Center">
                <FontIcon
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{StaticResource IconInfo}"
                    Visibility="{x:Bind IsInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <FontIcon
                    FontSize="13"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="{StaticResource IconCheckCircle}"
                    Visibility="{x:Bind IsSuccess, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <FontIcon
                    FontSize="13"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Glyph="{StaticResource IconAlertTriangle}"
                    Visibility="{x:Bind IsWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <FontIcon
                    FontSize="13"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="{StaticResource IconError}"
                    Visibility="{x:Bind IsError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                AutomationProperties.LiveSetting="Polite"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind StatusMessage, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <!--  Belirsiz progress: ring  -->
            <ProgressRing
                Width="16"
                Height="16"
                IsActive="{x:Bind IsProgressVisible, Mode=OneWay}"
                Visibility="{x:Bind IsProgressVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!--  Yüzdelik progress: bar + yüzde  -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ShowProgressBar, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar
                    Width="110"
                    Height="4"
                    VerticalAlignment="Center"
                    IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                    Maximum="100"
                    Value="{x:Bind ProgressValue, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ProgressText, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <!--  Sağ — kullanıcı · sistem veritabanı · saat  -->
        <StackPanel
            Grid.Column="1"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">

            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                Visibility="{x:Bind UserName, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE77B;" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind UserName, Mode=OneWay}" />
            </StackPanel>

            <Border
                Width="1"
                Height="14"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Visibility="{x:Bind DatabaseConnectionMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                Visibility="{x:Bind DatabaseConnectionMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                <Grid
                    Width="10"
                    Height="10"
                    VerticalAlignment="Center">
                    <Ellipse
                        Fill="{ThemeResource SystemFillColorSuccessBrush}"
                        Visibility="{x:Bind IsDatabaseConnection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Ellipse
                        Fill="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="{x:Bind IsDatabaseConnection, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                </Grid>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind DatabaseConnectionMessage, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border
                Width="1"
                Height="14"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock
                x:Name="TimeDisplay"
                MinWidth="55"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextAlignment="Right" />
        </StackPanel>
    </Grid>
</UserControl>
