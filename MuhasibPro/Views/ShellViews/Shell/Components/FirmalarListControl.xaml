<UserControl
    x:Class="MuhasibPro.Views.ShellViews.Shell.Components.FirmalarListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MuhasibPro.Converters"
    mc:Ignorable="d"
    VerticalAlignment="Stretch"
    HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:BoolToVisibilityConverter x:Key="FalseToVis" TrueValue="Collapsed" FalseValue="Visible" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header — baslik + sayi -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="{StaticResource MuhasibControlCornerRadius}" Background="{StaticResource MuhasibPetrolTintBrush}" BorderBrush="{StaticResource MuhasibPetrolBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <FontIcon Glyph="{StaticResource IconBuilding}" FontSize="13" Foreground="{StaticResource MuhasibPetrolDeepBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="KAYITLI FİRMALAR" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MuhasibTextPrimaryBrush}" VerticalAlignment="Center" />
                <Border Background="{StaticResource MuhasibOliveTintBrush}" BorderBrush="{StaticResource MuhasibOliveBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Padding="7,2">
                    <TextBlock Text="{Binding FirmaList.ItemsSource.Count, FallbackValue='0'}" FontSize="11" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" FontWeight="SemiBold" Foreground="{StaticResource MuhasibOliveDeepBrush}" VerticalAlignment="Center" />
                </Border>
                <ProgressRing Width="12" Height="12" IsActive="True" Foreground="{StaticResource MuhasibPetrolBrush}" Visibility="{Binding IsBusy, Converter={StaticResource TrueToVis}, FallbackValue=Collapsed}" Margin="2,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Arama -->
        <TextBox Grid.Row="1"
                 x:Name="SearchBox"
                 PlaceholderText="Firma kodu, ünvanı veya şehir ara..."
                 FontSize="12"
                 Padding="12,9"
                 Background="{StaticResource MuhasibInventCardBrush}"
                 BorderBrush="{StaticResource MuhasibSoftBorderBrush}"
                 Foreground="{StaticResource MuhasibTextPrimaryBrush}"
                 CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                 TextChanged="OnSearchTextChanged" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0" Background="Transparent">
            <ItemsControl ItemsSource="{Binding FirmaList.ItemsSource, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource MuhasibCardRadioButtonStyle}" HorizontalAlignment="Stretch"
                                     IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Checked="OnFirmaRadioChecked">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Kompakt header — her zaman -->
                                <Grid Grid.Row="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="{StaticResource MuhasibCardCornerRadius}" VerticalAlignment="Center"
                                            Background="{StaticResource MuhasibPetrolBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding FirmaNo, FallbackValue='-'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource MuhasibOnPetrolBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding FirmaKodu, FallbackValue='-'}" FontSize="7" Foreground="{StaticResource MuhasibOnPetrolBrush}" Opacity="0.85" HorizontalAlignment="Center" Margin="0,-1,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding KisaUnvani}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MuhasibTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Il, FallbackValue=''}" FontSize="11" Foreground="{StaticResource MuhasibSageTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="90" Visibility="{Binding Il, Converter={StaticResource StringToVis}}" />
                                            <TextBlock Text="•" FontSize="11" Foreground="{StaticResource MuhasibSageTertiaryBrush}" Visibility="{Binding Il, Converter={StaticResource StringToVis}}" />
                                            <TextBlock Text="{Binding Ilce, FallbackValue=''}" FontSize="11" Foreground="{StaticResource MuhasibSageTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="90" Visibility="{Binding Ilce, Converter={StaticResource StringToVis}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="{Binding VergiNo, Converter={StaticResource StringToVis}}">
                                            <TextBlock Text="VKN:" FontSize="11" Foreground="{StaticResource MuhasibSageTertiaryBrush}" />
                                            <TextBlock Text="{Binding VergiNo}" FontSize="11" Foreground="{StaticResource MuhasibSageTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Background="{StaticResource MuhasibInkBrush}" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Padding="8,3" VerticalAlignment="Center" Visibility="{Binding Selected, Converter={StaticResource TrueToVis}}">
                                            <TextBlock Text="Aktif Seçim" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MuhasibOnInkBrush}" />
                                        </Border>
                                        <Border Background="{StaticResource MuhasibOliveTintBrush}" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Padding="8,3" VerticalAlignment="Center" BorderBrush="{StaticResource MuhasibOliveBorderBrush}" BorderThickness="1" Visibility="{Binding Selected, Converter={StaticResource FalseToVis}}">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MuhasibOliveDeepBrush}" VerticalAlignment="Center">
                                                <Run Text="{Binding MaliDonemler.Count, FallbackValue='0'}" />
                                                <Run Text=" Dönem" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Zengin detay — sadece seçiliyken -->
                                <StackPanel Grid.Row="1" Spacing="7" Margin="0,10,0,0" Visibility="{Binding Selected, Converter={StaticResource TrueToVis}}">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="6" Visibility="{Binding YetkiliKisi, Converter={StaticResource StringToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="{StaticResource IconUser}" FontSize="10" Foreground="{StaticResource MuhasibSageTertiaryBrush}" />
                                                <TextBlock Text="Yetkili:" FontSize="10" Foreground="{StaticResource MuhasibSageTertiaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding YetkiliKisi}" FontSize="10" Foreground="{StaticResource MuhasibSageSecondaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="{StaticResource IconInfo}" FontSize="10" Foreground="{StaticResource MuhasibSageTertiaryBrush}" />
                                                <TextBlock Text="İletişim:" FontSize="10" Foreground="{StaticResource MuhasibSageTertiaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Telefon1, FallbackValue='-'}" FontSize="10" Foreground="{StaticResource MuhasibSageSecondaryBrush}" Visibility="{Binding Telefon1, Converter={StaticResource StringToVis}}" />
                                                <TextBlock Text="•" FontSize="10" Foreground="{StaticResource MuhasibSageTertiaryBrush}" Visibility="{Binding Telefon1, Converter={StaticResource StringToVis}}" />
                                                <TextBlock Text="{Binding Eposta, FallbackValue='-'}" FontSize="10" Foreground="{StaticResource MuhasibSageSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" Visibility="{Binding Eposta, Converter={StaticResource StringToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnSpacing="6" Visibility="{Binding VergiDairesi, Converter={StaticResource StringToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="{StaticResource IconShield}" FontSize="10" Foreground="{StaticResource MuhasibSageTertiaryBrush}" />
                                                <TextBlock Text="Vergi:" FontSize="10" Foreground="{StaticResource MuhasibSageTertiaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource MuhasibSageSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding VergiDairesi}" /><Run Text=" — " /><Run Text="{Binding VergiNo}" />
                                            </TextBlock>
                                        </Grid>
                                        <Grid ColumnSpacing="6" Visibility="{Binding Adres, Converter={StaticResource StringToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Top">
                                                <FontIcon Glyph="{StaticResource IconInfo}" FontSize="10" Foreground="{StaticResource MuhasibSageTertiaryBrush}" />
                                                <TextBlock Text="Adres:" FontSize="10" Foreground="{StaticResource MuhasibSageTertiaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Adres}" FontSize="10" Foreground="{StaticResource MuhasibSageSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                    <Rectangle Height="1" Fill="{StaticResource MuhasibSoftBorderBrush}" Opacity="0.6" Margin="0,2,0,0" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Button Tag="{Binding}" Click="OnMaliDonemYonetimClick" Style="{StaticResource PetrolButtonStyle}" ToolTipService.ToolTip="Mali Dönem İşlemleri (yönetim penceresi)">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="{StaticResource IconHardDrive}" FontSize="11" Foreground="{StaticResource MuhasibOnPetrolBrush}" />
                                                <TextBlock Text="Mali Dönem İşlemleri" Foreground="{StaticResource MuhasibOnPetrolBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="{Binding}" Click="OnEditFirmaClick" Style="{StaticResource PetrolTintButtonStyle}" ToolTipService.ToolTip="Düzenle">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="{StaticResource IconEdit}" FontSize="11" />
                                                <TextBlock Text="Düzenle" />
                                            </StackPanel>
                                        </Button>
                                        <Border Background="{StaticResource MuhasibOliveTintBrush}" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Padding="8,3" VerticalAlignment="Center" BorderBrush="{StaticResource MuhasibOliveBorderBrush}" BorderThickness="1">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MuhasibOliveDeepBrush}">
                                                <Run Text="{Binding MaliDonemler.Count, FallbackValue='0'}" />
                                                <Run Text=" Dönem" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
