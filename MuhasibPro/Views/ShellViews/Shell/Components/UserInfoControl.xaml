<UserControl
    x:Class="MuhasibPro.Views.ShellViews.Shell.Components.UserInfoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button
        x:Name="UserButton"
        CornerRadius="{StaticResource MuhasibCardCornerRadius}"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        VerticalAlignment="Center">
        <Button.Flyout>
            <MenuFlyout Placement="Bottom">
                <MenuFlyoutItem Text="Oturumu Kapat" Click="OnLogoutClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="{StaticResource IconLogOut}" FontSize="12"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Giriş Ekranına Dön" Click="OnLogoutClick" />
            </MenuFlyout>
        </Button.Flyout>
        <Border CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="Transparent" BorderThickness="0" Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <Border CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource MuhasibInventCardBrush}" BorderBrush="{ThemeResource MuhasibSoftBorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="InitialsText" Text="Ö" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource MuhasibSageSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="10" Height="10" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource MuhasibSuccessBrush}" BorderBrush="{ThemeResource MuhasibInventCardBrush}" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                </Grid>
                <StackPanel Spacing="1" VerticalAlignment="Center" MinWidth="92">
                    <TextBlock x:Name="NameText" Text="Ömer Korkut" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MuhasibTextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Border Background="{ThemeResource MuhasibInventPaleBrush}" CornerRadius="{StaticResource MuhasibControlCornerRadius}" Padding="5,1,5,2" BorderBrush="{ThemeResource MuhasibSoftBorderBrush}" BorderThickness="1">
                            <TextBlock Text="Admin" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibSageSecondaryBrush}"/>
                        </Border>
                        <TextBlock Text="•" FontSize="9" Foreground="{StaticResource MuhasibSageTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Aktif oturum" FontSize="9" Foreground="{StaticResource MuhasibSageTertiaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource MuhasibSageTertiaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>
        </Border>
    </Button>
</UserControl>
