<UserControl
    x:Class="MuhasibPro.Views.ShellViews.Shell.Components.UserInfoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button
        x:Name="UserButton"
        AutomationProperties.AutomationId="UserInfoButton"
        AutomationProperties.Name="Kullanıcı Menüsü"
        CornerRadius="{StaticResource MuhasibCardCornerRadius}"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        VerticalAlignment="Center">
        <Button.Flyout>
            <MenuFlyout Placement="Bottom">
                <MenuFlyoutItem
                    x:Name="YonetimMenuItem"
                    AutomationProperties.AutomationId="KullaniciYonetimiMenuItem"
                    Click="OnKullaniciYonetimiClick"
                    Text="Kullanıcı Yönetimi"
                    Visibility="Collapsed">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE716;" FontSize="12"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator x:Name="YonetimAyrac" Visibility="Collapsed"/>
                <MenuFlyoutItem Text="Oturumu Kapat" Click="OnLogoutClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="{StaticResource IconLogOut}" FontSize="12"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Giriş Ekranına Dön" Click="OnLogoutClick" />
            </MenuFlyout>
        </Button.Flyout>
        <Border CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="Transparent" BorderThickness="0" Padding="4,2" MinHeight="28">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Grid Width="24" Height="24" VerticalAlignment="Center">
                    <Border CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock x:Name="InitialsText" Text="Ö" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="8" Height="8" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource SystemFillColorSuccessBrush}" BorderBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                </Grid>
                <StackPanel Spacing="0" VerticalAlignment="Center" MinWidth="82">
                    <TextBlock x:Name="NameText" Text="Ömer Korkut" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource MuhasibControlCornerRadius}" Padding="4,0,4,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock Text="Admin" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                        <TextBlock Text="•" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Aktif oturum" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="1,0,0,0"/>
            </StackPanel>
        </Border>
    </Button>
</UserControl>
