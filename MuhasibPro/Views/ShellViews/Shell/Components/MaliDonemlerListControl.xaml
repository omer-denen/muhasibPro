<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.ShellViews.Shell.Components.MaliDonemlerListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MuhasibPro.Converters"
    xmlns:ui="using:MuhasibPro.Views.Components"
    mc:Ignorable="d"
    VerticalAlignment="Stretch"
    HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:BoolToVisibilityConverter x:Key="FalseToVis" TrueValue="Collapsed" FalseValue="Visible" />
        <converters:DatabaseStatusShortTextConverter x:Key="DbShortText" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header — baslik + sayac + yeni donem -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <FontIcon Glyph="{StaticResource IconCalendar}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Mali Dönemler" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Padding="7,2">
                    <TextBlock Text="{Binding MaliDonemList.ItemsSource.Count, FallbackValue='0'}" FontSize="11" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Click="OnYeniDonemClick" Style="{StaticResource SecondaryCompactButtonStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="Yeni mali dönem aç (saga)" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <FontIcon Glyph="{StaticResource IconAdd}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="Yeni Mali Dönem Aç" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Guncelleme bildirimi — bloklamayan InfoBar (tek donem: dogrudan sayfa / cok donem: Incele listesi) -->
        <InfoBar x:Name="GuncellemeInfoBar" Grid.Row="1" Margin="0,0,0,12"
                 IsOpen="{Binding MaliDonemList.GuncellemeVarMi, Mode=OneWay}"
                 Severity="Warning"
                 Title="Veritabanı güncellemesi hazır"
                 Message="{Binding MaliDonemList.GuncellemeOzeti}">
            <InfoBar.ActionButton>
                <Button x:Name="GuncellemeAksiyonButton" Click="OnGuncellemeAksiyonClick" CornerRadius="{StaticResource MuhasibControlCornerRadius}">
                    <TextBlock Text="{Binding MaliDonemList.GuncellemeAksiyonMetni}" />
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Bottom">
                            <ItemsControl ItemsSource="{Binding MaliDonemList.GuncellemeBekleyenDonemler}" MinWidth="260">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="1" Padding="0,4">
                                            <TextBlock Text="{Binding MaliYil}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding DbKisaDurumMetni}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Donem listesi — secilen satir accordion kart olarak acilir -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0" Background="Transparent">
            <Grid>
                <!-- Boş durum: firma seçili değilse -->
                <Border CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"
                        Visibility="{Binding IsFirmaSelected, Converter={StaticResource FalseToVis}, FallbackValue=Collapsed}"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconInfo}" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Bir firma seçin" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Yukarıdaki firma seçicisinden bir firma seçtiğinizde mali dönemleri burada görürsünüz." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Seçimli dönem listesi (tek seçim; seçilen satır kart gibi açılır) -->
                <ListView x:Name="DonemListesi"
                          ItemsSource="{Binding MaliDonemList.ItemsSource, Mode=OneWay}"
                          SelectedItem="{Binding MaliDonemList.SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single"
                          SelectionChanged="OnDonemSelectionChanged"
                          ItemContainerStyle="{StaticResource MuhasibDonemSelectionListItemStyle}"
                          Padding="0" Background="Transparent"
                          Visibility="{Binding IsFirmaSelected, Converter={StaticResource TrueToVis}, FallbackValue=Collapsed}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Kompakt satir basligi — her zaman gorunur -->
                                <Grid Grid.Row="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <FontIcon Glyph="{StaticResource IconCalendar}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding MaliYil, FallbackValue='2024'}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- Analiz ring — her donem kendi durumunu gosterir -->
                                        <ProgressRing Width="14" Height="14" IsActive="{Binding IsDbAnalyzing, Mode=OneWay}" Visibility="{Binding IsDbAnalyzing, Converter={StaticResource TrueToVis}}" VerticalAlignment="Center" />
                                        <!-- Guncelleme gerekli -->
                                        <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" Visibility="{Binding DbGuncellemeGerekliMi, Converter={StaticResource TrueToVis}}">
                                            <TextBlock Text="Güncelleme Gerekli" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- DB dosyasi yok -->
                                        <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1" Visibility="{Binding DbDosyaYokMu, Converter={StaticResource TrueToVis}}">
                                            <TextBlock Text="DB Yok" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Durum grubu (secili degilken) -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding Selected, Converter={StaticResource FalseToVis}}">
                                            <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" Visibility="{Binding KapaliMi, Converter={StaticResource TrueToVis}}">
                                                <TextBlock Text="Kapalı" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1" Visibility="{Binding KapaliMi, Converter={StaticResource FalseToVis}}">
                                                <TextBlock Text="Açık" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                        <!-- Son calisilan — notr vurgu (siralama degismez) -->
                                        <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="{Binding SonCalisilanMi, Converter={StaticResource TrueToVis}}" ToolTipService.ToolTip="En son bu dönemde çalışıldı">
                                            <TextBlock Text="Son çalışılan" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Accordion detay — sadece seciliyken gorunur -->
                                <StackPanel Grid.Row="1" Spacing="7" Margin="0,10,0,0"
                                            Visibility="{Binding Selected, Converter={StaticResource TrueToVis}}">
                                    <!-- Dosya yok uyarısı — giriş engelli, sadece Sil ile kayıt temizlenir -->
                                    <Border Padding="10" CornerRadius="{StaticResource MuhasibControlCornerRadius}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1"
                                            Visibility="{Binding DbDosyaYokMu, Converter={StaticResource TrueToVis}}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="{StaticResource IconAlertTriangle}" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="Veritabanı dosyası bulunamadı" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock Text="Bu döneme giriş yapılamaz. Mali Dönem İşlemleri penceresinden kurtarabilir ya da kaydı temizleyebilirsiniz." FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Spacing="7">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="{StaticResource IconHardDrive}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="Veritabanı:" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Grid Grid.Column="1" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DatabaseName, FallbackValue='Veritabanı yok'}" FontSize="10" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding BoyutMetni}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnSpacing="6" ToolTipService.ToolTip="{Binding DbAnalizDetay, TargetNullValue='Analiz bekleniyor — kart seçilince çalışır'}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="{StaticResource IconShield}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="DB Durumu:" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <ProgressRing Width="14" Height="14" IsActive="{Binding IsDbAnalyzing, Mode=OneWay}" Visibility="{Binding IsDbAnalyzing, Converter={StaticResource TrueToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsDbAnalyzing, Converter={StaticResource FalseToVis}}">
                                                    <Border Padding="7,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="{Binding DbAnalizYapildi, Converter={StaticResource FalseToVis}}">
                                                        <TextBlock Text="Analiz bekleniyor" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Padding="7,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1" Visibility="{Binding DbGuncelMi, Converter={StaticResource TrueToVis}}">
                                                        <TextBlock Text="{Binding DbDurum, Converter={StaticResource DbShortText}}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Padding="7,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" Visibility="{Binding DbGuncellemeGerekliMi, Converter={StaticResource TrueToVis}}">
                                                        <TextBlock Text="{Binding DbDurum, Converter={StaticResource DbShortText}}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Padding="7,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorAttentionBrush}" BorderThickness="1" Visibility="{Binding DbDosyaYokMu, Converter={StaticResource TrueToVis}}">
                                                        <TextBlock Text="{Binding DbDurum, Converter={StaticResource DbShortText}}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorAttentionBrush}" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Padding="7,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1" Visibility="{Binding DbKontrolGerekliMi, Converter={StaticResource TrueToVis}}">
                                                        <TextBlock Text="{Binding DbDurum, Converter={StaticResource DbShortText}}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <FontIcon Glyph="{StaticResource IconRefresh}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="Son Yedek:" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SonYedekMetni}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.65" Margin="0,2,0,0" />

                                    <!-- Aksiyon: kartta sadece Yedek Al (tam yönetim ayrı pencerede) -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Stretch">
                                        <Button Tag="{Binding}" Click="OnBackupClick" Style="{StaticResource GhostPillButtonStyle}" ToolTipService.ToolTip="Yedek Al" Visibility="{Binding DbDosyaYokMu, Converter={StaticResource FalseToVis}}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="{StaticResource IconDownload}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Yedek" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Bos durum: firma secili ama donem yok (Kural 11 — ring ile ayni anda gorunmez) -->
                <Border CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="16"
                        Visibility="{Binding MaliDonemList.BosDurumGoster, Converter={StaticResource TrueToVis}, FallbackValue=Collapsed}"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconInfo}" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding BosDonemBaslik, FallbackValue='Bu firmada mali dönem yok'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Çalışmaya başlamak için ilk dönemi oluşturun." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                        <HyperlinkButton Content="Yeni mali dönem aç" Click="OnYeniDonemClick" FontSize="12" Padding="0,2,0,0" HorizontalAlignment="Left" ToolTipService.ToolTip="Yeni mali dönem aç (saga)" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Footer: Kapali donem uyarisi (animasyonlu) — CTA alt bari FirmaShellView'da -->
        <ui:AnimatedInfoBorder x:Name="ClosedWarningBorder" Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Stretch" />
    </Grid>
</UserControl>
