<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MuhasibPro.Views.ShellViews.Shell.Components.Dialogs.TransferDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Anladım"
    PrimaryButtonStyle="{StaticResource InventDialogPrimaryStyle}"
    CloseButtonText="Kapat"
    DefaultButton="Primary"
    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="{StaticResource ControlCornerRadius}">

    <ContentDialog.Title>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="{StaticResource IconUpload}" FontSize="18" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="Taşınma" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="60"/>
                <TextBlock Text="Taşınmış Veri Tespit Edildi" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="12" MinWidth="420">
        <TextBlock Text="Bu kurulumda farklı bir kurulumdan gelen dönem veritabanları bulundu. Yedekler doğrulanırken kurulum/makine uyuşmazlığı amber uyarı olarak gösterilecektir." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        <Border Padding="12" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Mevcut Kurulum" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Grid.Column="1" x:Name="CurrentKurulumText" FontSize="11" FontFamily="{ThemeResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Mevcut Makine" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Grid.Column="1" x:Name="CurrentMachineText" FontSize="11" FontFamily="{ThemeResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </Grid>
            </StackPanel>
        </Border>
        <StackPanel Spacing="4">
            <TextBlock Text="Uyuşmayan dönemler:" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <ItemsControl x:Name="MismatchList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,6" Margin="0,0,0,6" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding}" FontSize="11" FontFamily="{ThemeResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</ContentDialog>
