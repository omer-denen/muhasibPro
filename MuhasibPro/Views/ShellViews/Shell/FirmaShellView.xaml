<?xml version="1.0" encoding="utf-8" ?>
    <Page
    x:Class="MuhasibPro.Views.ShellViews.Shell.FirmaShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:MuhasibPro.Views.ShellViews.Shell.Components"
    xmlns:converters="using:MuhasibPro.Converters"
    mc:Ignorable="d"
    Loaded="OnPageLoaded"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:BoolToVisibilityConverter x:Key="FalseToVis" TrueValue="Collapsed" FalseValue="Visible" />
    </Page.Resources>

    <!-- Kural 17 — Katman 1: kok Border (tema-resimli zemin + ~%35 tint). Statik. -->
    <Border x:Name="KokZemin" CornerRadius="0">
        <Grid>
            <Image Source="{ThemeResource UygulamaZeminGorseli}" Stretch="UniformToFill" />
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.35" />

            <Grid x:Name="RootGrid" Background="Transparent">

                <!-- Kural 17 — Katman 2: ana border paneli (tum icerigi cerceveler). Kenarlardan bosluklu;
                     ust bosluk pencere caption dugmeleri icin. Kural 13 ? butonu panelin sag ust kosesine bagli. -->
                <Grid x:Name="PanelWrap" MaxWidth="1600" Margin="24,48,24,24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border x:Name="AnaBorder"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}" Padding="24">
                        <Border.Shadow>
                            <ThemeShadow x:Name="AnaBorderShadow" />
                        </Border.Shadow>
                        <Grid x:Name="PanelGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Baslik seridi (Logo | Denetim Masasi | UserInfo) — panel ust kenari, sabit -->
                            <Border x:Name="StickyHeader" Grid.Row="0" Padding="0,0,0,12">
                                <Grid x:Name="HeaderGrid" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Tek border: 3 icerik sola yasli, aralarda dikey separator, logo yuksekliginde compact -->
                                    <Border Grid.Column="0" Style="{StaticResource CustomModernCard}" Padding="4" CornerRadius="{StaticResource MuhasibPillCornerRadius}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                            <!-- Logo -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Padding="6,2,8,2">
                                                <Image Width="22" Height="22" Source="ms-appx:///Assets/AppIcon.png" Stretch="Uniform" VerticalAlignment="Center" />
                                                <TextBlock Text="MuhasibPro" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Rectangle Width="1" Height="20" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.7" VerticalAlignment="Center" Margin="4,0"/>

                                            <!-- Denetim Masası — ayrı pencere açar (Oturum 244) -->
                                            <Button x:Name="DenetimMasasiButton" Click="OnDenetimMasasiClick" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" ToolTipService.ToolTip="Denetim Masası — tüm ayarlar (ayrı pencere)">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MinHeight="28" Padding="8,2">
                                                    <FontIcon Glyph="{StaticResource IconSettings}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Denetim Masası" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <Rectangle Width="1" Height="20" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.7" VerticalAlignment="Center" Margin="4,0"/>

                                            <!-- UserInfo — compact, aynı kapsül içinde -->
                                            <components:UserInfoControl DataContext="{x:Bind ViewModel, Mode=OneWay}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                <Grid x:Name="ContentRoot" HorizontalAlignment="Stretch">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup>
                                            <VisualState x:Name="WideState">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="1200" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Target="PanelsGrid.ColumnSpacing" Value="12" />
                                                    <Setter Target="PanelsGrid.RowSpacing" Value="0" />
                                                    <Setter Target="LeftPanel.(Grid.Column)" Value="0" />
                                                    <Setter Target="LeftPanel.(Grid.Row)" Value="0" />
                                                    <Setter Target="RightPanel.(Grid.Column)" Value="1" />
                                                    <Setter Target="RightPanel.(Grid.Row)" Value="0" />
                                                    <Setter Target="LeftPanel.MinHeight" Value="420" />
                                                    <Setter Target="RightPanel.MinHeight" Value="420" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="MediumState">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="800" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Target="PanelsGrid.ColumnSpacing" Value="12" />
                                                    <Setter Target="PanelsGrid.RowSpacing" Value="0" />
                                                    <Setter Target="LeftPanel.(Grid.Column)" Value="0" />
                                                    <Setter Target="LeftPanel.(Grid.Row)" Value="0" />
                                                    <Setter Target="RightPanel.(Grid.Column)" Value="1" />
                                                    <Setter Target="RightPanel.(Grid.Row)" Value="0" />
                                                    <Setter Target="LeftPanel.MinHeight" Value="380" />
                                                    <Setter Target="RightPanel.MinHeight" Value="380" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="NarrowState">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="0" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Target="PanelsGrid.ColumnSpacing" Value="0" />
                                                    <Setter Target="PanelsGrid.RowSpacing" Value="10" />
                                                    <Setter Target="RightPanel.(Grid.Column)" Value="0" />
                                                    <Setter Target="RightPanel.(Grid.Row)" Value="1" />
                                                    <Setter Target="LeftPanel.MinHeight" Value="320" />
                                                    <Setter Target="RightPanel.MinHeight" Value="320" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <StackPanel Spacing="12">

                                        <!-- Yuklenme progress (Kural 11) -->
                                        <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top"
                                                     Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="Transparent"
                                                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource TrueToVis}}" />
                                        <!-- Güncelleme ilerlemesi (onaylı göç) -->
                                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Progress.IsUpdating, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                                            <ProgressBar IsIndeterminate="True" Height="4" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.Progress.UpdateStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Baslik + birincil aksiyon (ana border icinde, kart degil) -->
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Firma &amp; Mali Dönem" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Çalışma ortamınızı seçin ve veritabanı bağlantısını kurun" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Click="OnYeniFirmaClick" VerticalAlignment="Center" Style="{StaticResource MuhasibPrimaryButtonStyle}" ToolTipService.ToolTip="Yeni firma tanımla">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{StaticResource IconAdd}" FontSize="12" Foreground="{ThemeResource MuhasibOnInkBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Yeni Firma" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibOnInkBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- 2 panel (Katman 3 kartlar) -->
                                        <Grid x:Name="PanelsGrid" ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border x:Name="LeftPanel" Grid.Column="0" Grid.Row="0" Style="{StaticResource CustomModernCard}" Padding="16" VerticalAlignment="Stretch" MinHeight="380">
                                                <components:FirmalarListControl DataContext="{x:Bind ViewModel, Mode=OneWay}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                                            </Border>
                                            <Border x:Name="RightPanel" Grid.Column="1" Grid.Row="0" Style="{StaticResource CustomModernCard}" Padding="16" VerticalAlignment="Stretch" MinHeight="380">
                                                <components:MaliDonemlerListControl DataContext="{x:Bind ViewModel, Mode=OneWay}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                                            </Border>
                                        </Grid>

                                        <!-- Surum footer (metin code-behind'den: AppSurumBilgisi.Metin) -->
                                        <TextBlock x:Name="SurumFooter" FontSize="11" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Opacity="0.6" />

                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Kural 13: sayfa yardimi (VM command) — ana border'in sag ust kosesinde -->
                    <Button x:Name="YardimButton" AutomationProperties.AutomationId="YardimButton" Width="36" Height="36" Padding="0" Margin="0,-10,-10,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource CircleIconButtonStyle}" Command="{x:Bind ViewModel.YardimCommand}"
                            ToolTipService.ToolTip="Firma seçimi hakkında yardım">
                        <FontIcon Glyph="{StaticResource IconHelpCircle}" FontSize="15" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>
