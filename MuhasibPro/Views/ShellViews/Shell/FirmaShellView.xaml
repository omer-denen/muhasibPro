<?xml version="1.0" encoding="utf-8" ?>
    <Page
    x:Class="MuhasibPro.Views.ShellViews.Shell.FirmaShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:MuhasibPro.Views.ShellViews.Shell.Components"
    xmlns:converters="using:MuhasibPro.Converters"
    mc:Ignorable="d"
    Loaded="OnPageLoaded"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:BoolToVisibilityConverter x:Key="FalseToVis" TrueValue="Collapsed" FalseValue="Visible" />
    </Page.Resources>

    <!-- Kural 17 — Katman 1: kok Border (tema-resimli zemin + ~%35 tint). Statik. -->
    <Border x:Name="KokZemin" CornerRadius="0">
        <Grid>
            <Image Source="{ThemeResource UygulamaZeminGorseli}" Stretch="UniformToFill" />
            <Border Background="{ThemeResource MuhasibZeminPerdeBrush}" />

            <Grid x:Name="RootGrid" Background="Transparent">

                <!-- Kural 17 — Katman 2: ana border paneli (tum icerigi cerceveler). Kenarlardan bosluklu;
                     ust bosluk pencere caption dugmeleri icin. Kural 13 ? butonu panelin sag ust kosesine bagli. -->
                <Grid x:Name="PanelWrap" MaxWidth="1600" Margin="24,48,24,24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border x:Name="AnaBorder"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource MuhasibAnaBorderCizgiBrush}" BorderThickness="1.5"
                            CornerRadius="{StaticResource OverlayCornerRadius}" Padding="24"
                            Translation="0,0,32">
                        <Border.Shadow>
                            <ThemeShadow x:Name="AnaBorderShadow" />
                        </Border.Shadow>
                        <Grid x:Name="PanelGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header — solda logo, ortada dashboard basligi, sagda Ayarlar + UserInfo -->
                            <Grid x:Name="HeaderGrid" Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CustomModernCard}" Padding="8,4" CornerRadius="{StaticResource MuhasibPillCornerRadius}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Image Width="22" Height="22" Source="ms-appx:///Assets/AppIcon.png" Stretch="Uniform" VerticalAlignment="Center" />
                                        <TextBlock Text="MuhasibPro" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="Firma &amp; Mali Dönem" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Çalışma ortamınızı seçin ve veritabanı bağlantısını kurun" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Tema kisayolu: kayar anahtar (sol=Acik / sag=Koyu).
                                         Sistem temasi Gorunum'de; anahtar Sistem'deyken efektif temayi gosterir. -->
                                    <Border x:Name="TemaPill" CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            Padding="8,2" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Tema: Açık / Koyu (Sistem teması için: Ayarlar → Görünüm)">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="{StaticResource IconBrightness}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="Açık tema" />
                                            <ToggleSwitch x:Name="TemaToggle" MinWidth="0" Padding="0" Margin="0" VerticalAlignment="Center"
                                                          OnContent="" OffContent=""
                                                          AutomationProperties.AutomationId="TemaToggle"
                                                          Toggled="OnTemaToggleToggled" />
                                            <FontIcon Glyph="{StaticResource IconContrast}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="Koyu tema" />
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="AyarlarButton" AutomationProperties.AutomationId="AyarlarButton" Click="OnDenetimMasasiClick"
                                            CornerRadius="{StaticResource MuhasibCardCornerRadius}" Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Ayarlar — tüm uygulama ayarları (ayrı pencere)">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MinHeight="30" Padding="8,2">
                                            <FontIcon Glyph="{StaticResource IconSettings}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Ayarlar" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FirmaYonetimiButton" AutomationProperties.AutomationId="FirmaYonetimiButton" Command="{x:Bind ViewModel.FirmaYonetimiCommand, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.FirmaYonetimiYetkisi, Mode=OneWay}"
                                            CornerRadius="{StaticResource MuhasibCardCornerRadius}" Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.FirmaYonetimiNedenTooltip, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MinHeight="30" Padding="8,2">
                                            <FontIcon Glyph="{StaticResource IconBuilding}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Firma Yönetimi" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Rectangle Width="1" Height="20" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.7" VerticalAlignment="Center" />
                                    <components:UserInfoControl DataContext="{x:Bind ViewModel, Mode=OneWay}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Yukleme / guncelleme ilerlemesi (Kural 11) -->
                            <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,12">
                                <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top"
                                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="Transparent"
                                             Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource TrueToVis}}" />
                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Progress.IsUpdating, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                                    <ProgressBar IsIndeterminate="True" Height="4" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.Progress.UpdateStatus, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Inline tenant göç ilerlemesi (Faz 6.91-E; Kural 12: determinate + adım rozetleri) -->
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.UpdateCoordinator.Akis.IsRunning, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                                    <ProgressBar Value="{x:Bind ViewModel.UpdateCoordinator.Akis.ProgressYuzde, Mode=OneWay}" Maximum="100" Height="4"
                                                 Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.UpdateCoordinator.Akis.AktifAdim, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.UpdateCoordinator.Akis.Steps, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="14" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                              Visibility="{Binding IsDone, Converter={StaticResource TrueToVis}}" />
                                                    <ProgressRing IsActive="{Binding IsRunning}" Width="12" Height="12"
                                                                  Visibility="{Binding IsRunning, Converter={StaticResource TrueToVis}}" />
                                                    <FontIcon Glyph="&#xE783;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                              Visibility="{Binding IsFaulted, Converter={StaticResource TrueToVis}}" />
                                                    <FontIcon Glyph="&#xE738;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                              Visibility="{Binding IsPending, Converter={StaticResource TrueToVis}}" />
                                                    <TextBlock Text="{Binding Title}" FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="10" VerticalAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                <Grid x:Name="ContentRoot" HorizontalAlignment="Stretch">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup>
                                            <VisualState x:Name="WideState">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="1200" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Target="PanelsGrid.ColumnSpacing" Value="12" />
                                                    <Setter Target="PanelsGrid.RowSpacing" Value="0" />
                                                    <Setter Target="LeftPanel.(Grid.Column)" Value="0" />
                                                    <Setter Target="LeftPanel.(Grid.Row)" Value="0" />
                                                    <Setter Target="RightPanel.(Grid.Column)" Value="1" />
                                                    <Setter Target="RightPanel.(Grid.Row)" Value="0" />
                                                    <Setter Target="LeftPanel.MinHeight" Value="420" />
                                                    <Setter Target="RightPanel.MinHeight" Value="420" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="MediumState">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="800" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Target="PanelsGrid.ColumnSpacing" Value="12" />
                                                    <Setter Target="PanelsGrid.RowSpacing" Value="0" />
                                                    <Setter Target="LeftPanel.(Grid.Column)" Value="0" />
                                                    <Setter Target="LeftPanel.(Grid.Row)" Value="0" />
                                                    <Setter Target="RightPanel.(Grid.Column)" Value="1" />
                                                    <Setter Target="RightPanel.(Grid.Row)" Value="0" />
                                                    <Setter Target="LeftPanel.MinHeight" Value="380" />
                                                    <Setter Target="RightPanel.MinHeight" Value="380" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="NarrowState">
                                                <VisualState.StateTriggers>
                                                    <AdaptiveTrigger MinWindowWidth="0" />
                                                </VisualState.StateTriggers>
                                                <VisualState.Setters>
                                                    <Setter Target="PanelsGrid.ColumnSpacing" Value="0" />
                                                    <Setter Target="PanelsGrid.RowSpacing" Value="10" />
                                                    <Setter Target="RightPanel.(Grid.Column)" Value="0" />
                                                    <Setter Target="RightPanel.(Grid.Row)" Value="1" />
                                                    <Setter Target="LeftPanel.MinHeight" Value="320" />
                                                    <Setter Target="RightPanel.MinHeight" Value="320" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <StackPanel Spacing="12">
                                        <!-- 2 panel (Katman 3 kartlar): sol firma secici + secili firma karti, sag donem listesi -->
                                        <Grid x:Name="PanelsGrid" ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border x:Name="LeftPanel" Grid.Column="0" Grid.Row="0" Style="{StaticResource CustomModernCard}" Padding="16" VerticalAlignment="Stretch" MinHeight="380">
                                                <components:FirmalarListControl DataContext="{x:Bind ViewModel, Mode=OneWay}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                                            </Border>
                                            <Border x:Name="RightPanel" Grid.Column="1" Grid.Row="0" Style="{StaticResource CustomModernCard}" Padding="16" VerticalAlignment="Stretch" MinHeight="380">
                                                <components:MaliDonemlerListControl DataContext="{x:Bind ViewModel, Mode=OneWay}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
                                            </Border>
                                        </Grid>

                                        <!-- Surum footer (metin code-behind'den: AppSurumBilgisi.Metin) -->
                                        <TextBlock x:Name="SurumFooter" FontSize="11" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Opacity="0.6" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <!-- CTA alt bari (Kural 16: birincil aksiyon her zaman gorunur) — solda secim ozeti, sagda gecis -->
                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.6" />
                                <Grid Grid.Row="1" Margin="0,12,0,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="{StaticResource IconCheckCircle}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.SecimOzeti, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="DevamEtButton"
                                            Content="Çalışma Alanına Geç"
                                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.DevamEtCommand, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.DevamEtNedenTooltip, Mode=OneWay}"
                                            Padding="16,10" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Kural 13: sayfa yardimi (VM command) — ana border'in sag ust kosesinde -->
                    <Button x:Name="YardimButton" AutomationProperties.AutomationId="YardimButton" Width="36" Height="36" Padding="0" Margin="0,-10,-10,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource CircleIconButtonStyle}" Command="{x:Bind ViewModel.YardimCommand}"
                            ToolTipService.ToolTip="Firma seçimi hakkında yardım">
                        <FontIcon Glyph="{StaticResource IconHelpCircle}" FontSize="15" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>
