<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MuhasibPro.Views.Settings.UpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MuhasibPro.Converters"
    mc:Ignorable="d"
    Loaded="OnPageLoaded"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
    </Page.Resources>

    <!-- Kural 17 — Katman 1: kok Border (tema-resimli zemin + ~%87 opak tint). Statik; icerik degisince yeniden olusmaz. -->
    <Border x:Name="KokZemin" CornerRadius="0">
        <Grid x:Name="RootGrid">
            <Image x:Name="ZeminGorseli" Source="{ThemeResource UygulamaZeminGorseli}" Stretch="UniformToFill" />
            <Border x:Name="ZeminPerdesi" Background="{ThemeResource MuhasibZeminPerdeBrush}" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Kural 17 — Katman 2: ana border paneli; Kural 13 ? panelin sag ust kosesinde.
             Gömülü modda (Denetim Masası) GomuluUygula KokZemin'i gizler. -->
        <Grid x:Name="PanelWrap" MaxWidth="800" Margin="24,18,24,24" HorizontalAlignment="Center">
        <Border x:Name="AnaBorder"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource MuhasibAnaBorderCizgiBrush}" BorderThickness="1.5"
                CornerRadius="{StaticResource OverlayCornerRadius}" Padding="24"
                Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow x:Name="AnaBorderShadow" />
            </Border.Shadow>
        <StackPanel Spacing="12">

            <!-- Başlık (gömülü modda GomuluUygula ile gizlenir — çift başlık olmaz) -->
            <Grid x:Name="BaslikSatiri" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Güncellemeler" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Uygulama sürümü ve güncelleme kaynağı" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="Şimdi Kontrol Et" Style="{StaticResource SecondaryCompactButtonStyle}" Command="{x:Bind ViewModel.CheckNowCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsCheckButtonEnabled, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.LastCheckText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <Pivot>
                <!-- Güncelleme sekmesi -->
                <PivotItem Header="Güncelleme">
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <!-- Durum kartı -->
                        <Border Style="{StaticResource CustomModernCard}" Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind ViewModel.StatusIconGlyph, Mode=OneWay}" FontSize="20" Foreground="{ThemeResource MuhasibPetrolBrush}" VerticalAlignment="Center" />
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressPercentage, Mode=OneWay}" Foreground="{ThemeResource MuhasibPetrolBrush}" Visibility="{x:Bind ViewModel.ProgressVisible, Mode=OneWay, Converter={StaticResource TrueToVis}}" />
                                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ProgressDetails, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />

                                <!-- Hata bandı -->
                                <Border Padding="10" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                </Border>

                                <!-- Güncelleme detay + aksiyon -->
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.UpdateCardVisible, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                                    <TextBlock Text="{x:Bind ViewModel.UpdateSize, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ReleaseDate, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ChangelogUrl, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ChangelogUrl, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                                    <Button Content="{x:Bind ViewModel.UpdateButtonText, Mode=OneWay}" Style="{StaticResource MuhasibPrimaryButtonStyle}" Command="{x:Bind ViewModel.UpdateActionCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsUpdateButtonEnabled, Mode=OneWay}" HorizontalAlignment="Left" />
                                </StackPanel>

                                <!-- Detay görünümü (indirme/kurulum dışı) -->
                                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.DetailsVisible, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                                    <TextBlock Text="{x:Bind ViewModel.UpdateSize, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ChangelogUrl, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ChangelogUrl, Mode=OneWay, Converter={StaticResource StringToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </PivotItem>

                <!-- Ayarlar sekmesi -->
                <PivotItem Header="Ayarlar">
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <!-- Kaynak kartı -->
                        <Border Style="{StaticResource CustomModernCard}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Güncelleme kaynağı" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.FeedUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://github.com/kullanici/repo" FontSize="12" />
                                <TextBlock Text="GitHub repo adresi veya Velopack feed adresi. Değişiklik otomatik kaydedilir." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Bağlantıyı Dene" Style="{StaticResource SecondaryCompactButtonStyle}" Command="{x:Bind ViewModel.CheckNowCommand, Mode=OneWay}" />
                                    <Button Content="Varsayılana sıfırla" Style="{StaticResource SecondaryCompactButtonStyle}" Command="{x:Bind ViewModel.VarsayilanaSifirlaCommand, Mode=OneWay}" ToolTipService.ToolTip="Derlemede gömülü repo adresine döndür" />
                                </StackPanel>
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap">
                                    <Run Text="Varsayılan (gömülü): " /><Run Text="{x:Bind ViewModel.VarsayilanFeedUrl, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Seçenekler kartı -->
                        <Border Style="{StaticResource CustomModernCard}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Seçenekler" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <ToggleSwitch Header="Açılışta otomatik kontrol" IsOn="{x:Bind ViewModel.AutoCheckEnabled, Mode=TwoWay}" />
                                <ToggleSwitch Header="Bildirimleri göster" IsOn="{x:Bind ViewModel.NotificationsEnabled, Mode=TwoWay}" />
                                <ToggleSwitch Header="Beta sürümleri dahil et" IsOn="{x:Bind ViewModel.IncludeBetaVersionsEnabled, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </PivotItem>
            </Pivot>

        </StackPanel>
        </Border>

        </Grid>
    </ScrollViewer>
        </Grid>
    </Border>
</Page>
