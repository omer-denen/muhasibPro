<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MuhasibPro.Views.MainShell.MainShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:components="using:MuhasibPro.Views.MainShell.Components"
    xmlns:ortak="using:MuhasibPro.Views.Components"
    xmlns:shell="using:MuhasibPro.Views.ShellViews.Shell"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnPageLoaded"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- Kural 17 — Katman 1: kok Border (tema-resimli zemin + ~%87 opak tint). Statik; icerik degisince yeniden olusmaz. -->
    <Border x:Name="KokZemin" CornerRadius="0">
        <Grid>
            <Image Source="{ThemeResource UygulamaZeminGorseli}" Stretch="UniformToFill" />
            <Border Background="{ThemeResource MuhasibZeminPerdeBrush}" />

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sol: NavSidebar 240 -->
        <components:NavSidebarControl Grid.Column="0" Grid.Row="0" ViewModel="{x:Bind ViewModel}" />

        <!-- Kural 17 — Katman 2: sağ içerik ana border paneli (sidebar zemin üzerinde kalır);
             Kural 13 ? panelin sağ üst köşesinde. -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid x:Name="PanelWrap" Margin="24,48,24,24">
                <Border x:Name="AnaBorder"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource MuhasibAnaBorderCizgiBrush}" BorderThickness="1.5"
                        CornerRadius="{StaticResource OverlayCornerRadius}" Padding="24"
                        Translation="0,0,32">
                    <Border.Shadow>
                        <ThemeShadow x:Name="AnaBorderShadow" />
                    </Border.Shadow>
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

            <!-- Başlık + birincil aksiyon (panel içi, kart değil) -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Genel Bakış" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <!-- Kural 21: işlevsiz "Snapshot Yedek" yer tutucu butonu kaldırıldı. -->
            </Grid>

            <!-- İçerik alanı: navigasyon bu çerçeveye yüklenir (Kural 21: sahte içerik/yer tutucu yok). -->
            <Frame x:Name="ContentFrame" Grid.Row="1" Padding="0,16,0,0" />
                    </Grid>
                </Border>

                <!-- Kural 13: sayfa yardimi (VM command) — ana border'in sag ust kosesinde -->
                <Button x:Name="YardimButton" AutomationProperties.AutomationId="YardimButton" Width="36" Height="36" Padding="0" Margin="0,-10,-10,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource CircleIconButtonStyle}" Command="{x:Bind ViewModel.YardimCommand}"
                        ToolTipService.ToolTip="Çalışma alanı hakkında yardım">
                    <FontIcon Glyph="{StaticResource IconHelpCircle}" FontSize="15" />
                </Button>
            </Grid>
        </Grid>

        <!-- Kural 17/footer: ana pencere durum çubuğu (tam genişlik). AI asistanı bu çubuktaki
             🤖 düğmesine bağlı Flyout olarak pencerenin ÜSTÜNDE açılır (MainShell yerleşimine girmez). -->
        <shell:ShellStatusBar x:Name="ShellStatusBarControl" Grid.Row="1" Grid.ColumnSpan="2" />

        <!-- Faz 6.86: uygulama içi bildirim host'u (OS toast yerine) — içerik alanı üstünde -->
        <ortak:InAppMessageHost
            Grid.Row="0"
            Grid.Column="1"
            Margin="24,48,24,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Canvas.ZIndex="50" />
    </Grid>
        </Grid>
    </Border>
</Page>
