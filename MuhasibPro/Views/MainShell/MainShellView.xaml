<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MuhasibPro.Views.MainShell.MainShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:components="using:MuhasibPro.Views.MainShell.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource InventEaseBackgroundBrush}">

    <Grid Background="{ThemeResource InventEaseBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: NavSidebar 240 -->
        <components:NavSidebarControl Grid.Column="0" />

        <!-- Sağ: yüzen başlık satırı + buz kap -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Yüzen başlık satırı -->
            <Grid Grid.Row="0" Padding="24,12,24,12">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Genel Bakış" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostTintPetrolButtonStyle}" ToolTipService.ToolTip="Snapshot Yedek (Faz B)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{StaticResource IconBackup}" FontSize="12" Foreground="{StaticResource MuhasibPetrolDeepBrush}" />
                            <TextBlock Text="Snapshot Yedek" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MuhasibPetrolDeepBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Buz kap: tenant kartı + içerik -->
            <Border Grid.Row="1" Margin="24,0,24,24" Style="{StaticResource InventFrostPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tenant header kartı -->
                    <Border Grid.Row="0" Style="{StaticResource InventCardStyle}" Padding="16" Margin="0,0,0,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="{StaticResource MuhasibPetrolTintBrush}" CornerRadius="{StaticResource MuhasibCardCornerRadius}">
                                <FontIcon Glyph="{StaticResource IconCheckMark}" FontSize="18" Foreground="{StaticResource MuhasibPetrolDeepBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="MuhasibPro — Ana Çalışma Alanı" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Tenant bağlantısı başarılı — Çok kiracılı SQLite aktif" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Background="{StaticResource MuhasibSuccessBgBrush}" CornerRadius="{StaticResource MuhasibControlCornerRadius}" Padding="8,4">
                                    <TextBlock Text="WAL Aktif" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MuhasibSuccessBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Faz B hazır placeholder -->
                    <Frame x:Name="ContentFrame" Grid.Row="1" Padding="0,16,0,0">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <FontIcon Glyph="{StaticResource IconCheckMark}" FontSize="48" Foreground="{StaticResource MuhasibSuccessBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Hazır — Tenant seçimi başarılı" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="FirmaShell → MainShell geçişi doğrulandı. Faz B modülleri (Cari/Stok/Fatura) bu iskelet üzerine eklenecek." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Center" />
                                <Border Background="{StaticResource MuhasibPetrolTintBrush}" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Padding="12,8" Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="Çekirdek (Aşama A) 0 kusur ile tamamlandı — Güncelleme altyapısı dahil" FontSize="11" Foreground="{StaticResource MuhasibPetrolDeepBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Frame>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
