<Page
    x:Class="MuhasibPro.Views.SistemDbYonetim.SistemDbYonetimView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:components="using:MuhasibPro.Views.SistemDbYonetim.Components"
    xmlns:converters="using:MuhasibPro.Converters"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        </ResourceDictionary>
    </Page.Resources>

    <!-- Kural 17 — Katman 1: kok Border (tema-resimli zemin + ~%87 opak tint). Statik; icerik degisince yeniden olusmaz. -->
    <Border x:Name="KokZemin" CornerRadius="0">
        <Grid>
            <Image Source="{ThemeResource UygulamaZeminGorseli}" Stretch="UniformToFill" />
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.35" />

            <Grid x:Name="RootGrid" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Center" Spacing="16" Padding="32,24,32,28">

                <!-- ===== SAYFA HEADER (migration/onarım bağlamı) ===== -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <Image Grid.Column="0" Width="44" Height="44" Source="ms-appx:///Assets/AppIcon.png" Stretch="Uniform" VerticalAlignment="Center" />

                    <!-- Başlık + canlı durum açıklaması -->
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Sistem Veritabanı Yönetimi" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Durum hapı -->
                    <Border Grid.Column="2" Padding="12,7" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.DbDurumMetni, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Yardım (Kural 13) -->
                    <Button Grid.Column="3" Width="32" Height="32" Padding="0" Style="{StaticResource CircleIconButtonStyle}" VerticalAlignment="Center" Click="OnYardimClick"
                            ToolTipService.ToolTip="Bu sayfa hakkında yardım">
                        <FontIcon Glyph="{StaticResource IconHelpCircle}" FontSize="14" />
                    </Button>
                </Grid>

                <!-- ===== BÖLÜM: DURUM VE İŞLEMLER ===== -->
                <TextBlock Text="Durum ve işlemler" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,8,0,0" />
                <components:DatabaseInfoPanel ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

                <!-- ===== BÖLÜM: YEDEKLEME VE GÜNCELLEME ===== -->
                <TextBlock Text="Yedekleme ve güncelleme" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,8,0,0" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <components:SistemYedekPanel Grid.Column="0" ViewModel="{x:Bind ViewModel.Yedek, Mode=OneWay}" VerticalAlignment="Top" />
                    <components:SistemGuncellemePanel Grid.Column="1" ViewModel="{x:Bind ViewModel.Guncelleme, Mode=OneWay}" VerticalAlignment="Top" />
                </Grid>

                <!-- ===== 2 KOLON: TANI + KAYIT | GÜNLÜK ===== -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Top">
                        <TextBlock Text="Tanı ve kurulum kaydı" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,8,0,0" />
                        <components:SystemTestsPanel ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                        <components:KurulumKayitPanel ViewModel="{x:Bind ViewModel.KurulumKayit, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
                        <TextBlock Text="İşlem günlüğü" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,8,0,0" />
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}" Padding="16">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="{StaticResource ControlCornerRadius}" Background="{ThemeResource MuhasibTerminalBgBrush}"><FontIcon Glyph="{StaticResource IconTerminal}" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="Canlı onarım ve tanı akışı" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13"/>
                                        <TextBlock Text="Doğrulama, onarım ve güncelleme adımları buraya yazılır" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="8,4" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorSuccessBrush}"/>
                                            <TextBlock Text="CANLI" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Background="{ThemeResource MuhasibTerminalBgBrush}" CornerRadius="{StaticResource OverlayCornerRadius}" Padding="12,10" BorderBrush="{ThemeResource MuhasibTerminalBorderBrush}" BorderThickness="1">
                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.LogsText, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            FontFamily="{StaticResource MuhasibMonospaceFontFamily}"
                                            FontSize="11"
                                            LineHeight="16"
                                            Foreground="{ThemeResource MuhasibTerminalTextPrimaryBrush}"
                                            IsTextSelectionEnabled="True" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== SABİT ALT BAR ===== -->
        <Border Grid.Row="1" Padding="0,12,0,10" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <Button
                    Command="{x:Bind ViewModel.GoToLoginCommand}"
                    Visibility="{x:Bind ViewModel.IsKurulumTamamlandi, Mode=OneWay, Converter={StaticResource TrueToVis}}"
                    Padding="20,14"
                    HorizontalAlignment="Center"
                    MinWidth="280"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Giriş Ekranına Devam Et" FontSize="14" FontWeight="SemiBold" />
                        <FontIcon Glyph="{StaticResource IconChevronRight}" FontSize="14" />
                    </StackPanel>
                </Button>

                <!-- Sürüm alt bilgi -->
                <TextBlock x:Name="SurumFooter" Style="{StaticResource CaptionTextBlockStyle}" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Opacity="0.6" />
            </StackPanel>
            </Border>
            </Grid>
        </Grid>
    </Border>
</Page>
