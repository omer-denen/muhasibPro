<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.SistemDbYonetim.Components.SistemYedekPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MuhasibPro.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:BoolToVisibilityConverter x:Key="FalseToVis" TrueValue="Collapsed" FalseValue="Visible" />
    </UserControl.Resources>

    <Border Style="{StaticResource CustomModernCard}" Padding="16">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="{StaticResource MuhasibControlCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"><FontIcon Glyph="{StaticResource IconBackup}" FontSize="13" Foreground="{ThemeResource SystemFillColorAttentionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Yedekleme ve geri yükleme" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.SonYedekMetni, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <Border Grid.Column="2" Padding="8,5" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.Yedekler.Count, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="yedek" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.SaklamaMetni, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

            <!-- Satır-butonlu liste: seçim yok, her satır kendi Geri Yükle butonunu taşır (tenant deseni). -->
            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="6"
                    Visibility="{x:Bind ViewModel.YedekListesiBos, Mode=OneWay, Converter={StaticResource FalseToVis}}">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Yedekler, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{StaticResource MuhasibCardCornerRadius}" Padding="10,8" Margin="0,0,0,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        ToolTipService.ToolTip="{Binding BackupFileName}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding YedekTarihMetni}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                <Run Text="{Binding BackupDisplayName}" /><Run Text=" • " /><Run Text="{Binding BackupFileSizeDisplay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Tag="{Binding}" Click="OnGeriYukleClick" Style="{StaticResource GhostPillButtonStyle}" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Bu yedeği geri yükle (Sistem.db üzerine yazılır)">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="{StaticResource IconUpload}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock Text="Geri Yükle" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Boş-durum: ring ile aynı anda görünmez (Kural 11). -->
            <Border Padding="16,14" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{x:Bind ViewModel.YedekListesiBos, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                <TextBlock Text="Henüz yedek yok — 'Şimdi Yedekle' ile ilk yedeği alın." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            </Border>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{x:Bind ViewModel.YedekAlCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="0,11">
                    <TextBlock Text="Şimdi Yedekle" FontWeight="SemiBold" FontSize="12" />
                </Button>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.YenileCommand}" Style="{StaticResource GhostPillButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{StaticResource IconRefresh}" FontSize="12" />
                        <TextBlock Text="Yenile" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                <ProgressRing Width="14" Height="14" IsActive="True" />
                <TextBlock Text="{x:Bind ViewModel.DurumMetni, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.DurumMetni, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource FalseToVis}}" />
        </StackPanel>
    </Border>
</UserControl>
