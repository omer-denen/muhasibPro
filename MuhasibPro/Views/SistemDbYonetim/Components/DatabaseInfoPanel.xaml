<UserControl
    x:Class="MuhasibPro.Views.SistemDbYonetim.Components.DatabaseInfoPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MuhasibPro.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:BoolToVisibilityConverter x:Key="FalseToVis" TrueValue="Collapsed" FalseValue="Visible" />
    </UserControl.Resources>

    <StackPanel Spacing="16">
        <!-- 1+2 — Sistem Durumu (sol) + Veritabanı İşlemleri (sağ), tek satır -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        <!-- 1 — Sistem Durumu (premium metrics + path) -->
        <Border Grid.Column="0" VerticalAlignment="Top" Style="{StaticResource CustomModernCard}">
            <StackPanel Spacing="14">
                <!-- Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="42"
                        Height="42"
                        CornerRadius="{StaticResource MuhasibCardCornerRadius}"
                        Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                        <FontIcon
                            Glyph="{StaticResource IconDatabase}"
                            FontSize="20"
                            Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Sistem Durumu" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.85" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            TextWrapping="Wrap"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Global.db • SQLite WAL • PBKDF2" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <Border
                        Grid.Column="2"
                        Padding="10,7"
                        CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                IsActive="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay}"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorAttentionBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="%" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorAttentionBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Metrics 2x2 -->
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Padding="12,10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" VerticalAlignment="Center"><FontIcon Glyph="{StaticResource IconHardDrive}" FontSize="13" Foreground="{ThemeResource SystemFillColorAttentionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="BOYUT" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.DbSize, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Padding="12,10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" VerticalAlignment="Center"><FontIcon Glyph="{StaticResource IconLayers}" FontSize="13" Foreground="{ThemeResource SystemFillColorAttentionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="SÜRÜM" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.DbVersion, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Padding="12,10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" VerticalAlignment="Center"><FontIcon Glyph="{StaticResource IconPackage}" FontSize="13" Foreground="{ThemeResource SystemFillColorAttentionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="BİLEŞEN" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{x:Bind ViewModel.TableCount, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" /><TextBlock Text="tablo" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Padding="12,10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" VerticalAlignment="Center"><FontIcon Glyph="{StaticResource IconShield}" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="DOĞRULAMA" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.IsDbValidMetni, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Dosya yolu -->
                <Border CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Padding="12,10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <FontIcon Glyph="{StaticResource IconHardDrive}" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Veritabanı Dosya Yolu" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.DbPath, Mode=OneWay}" FontSize="11" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Progress -->
                <Border
                    CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}"
                    Padding="12,10"
                    Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                    BorderThickness="1"
                    Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="14" Height="14" IsActive="True" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                            <TextBlock Text="Kurulum devam ediyor…" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorAttentionBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorAttentionBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="%" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorAttentionBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Height="6" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    </Grid>
                </Border>

                <!-- Primary action -->
                <Button
                    Command="{x:Bind ViewModel.InitializeGlobalDbCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Padding="0,14"
                    Visibility="{x:Bind ViewModel.IsKurulumGerekli, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="{StaticResource IconZap}" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock Text="Kurulumu Başlat" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <FontIcon Glyph="{StaticResource IconChevronRight}" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.9" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 2 — Veritabanı İşlemleri -->
        <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource CustomModernCard}">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="{StaticResource IconWrench}" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Veritabanı İşlemleri" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Durumu doğrula, hatayı hızla çöz" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>

                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.TestSystemClassesCommand}"
                    IsEnabled="{x:Bind ViewModel.CanAnalyze, Mode=OneWay}"
                    Padding="0,11"
                    Style="{StaticResource GhostPillButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="{StaticResource IconSearch}" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Sistemi Analiz Et" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>

                <!-- Başarı / Hata bannerları — sol vurgu çizgili -->
                <Border
                    CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}"
                    Padding="0"
                    BorderThickness="0"
                    Visibility="{x:Bind ViewModel.IsKurulumTamamlandi, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                    <Grid>
                        <Border CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1" />
                        <Border Width="4" HorizontalAlignment="Left" CornerRadius="{StaticResource MuhasibAccentCornerRadius}" Background="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Grid Padding="14,13" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1"><FontIcon Glyph="{StaticResource IconCheckMark}" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Veritabanı Güncel" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.DbDurumAciklama, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Opacity="0.9" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}"
                    Padding="0"
                    BorderThickness="0"
                    Visibility="{x:Bind ViewModel.IsKurulumGerekli, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                    <Grid>
                        <Border CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1" />
                        <Border Width="4" HorizontalAlignment="Left" CornerRadius="{StaticResource MuhasibAccentCornerRadius}" Background="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Grid Padding="14,13" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1"><FontIcon Glyph="{StaticResource IconError}" FontSize="18" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Kurulum Gerekli" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="Veritabanı dosyası bulunamadı veya geçersiz — kurulum başlatın" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Opacity="0.9" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- Onar butonu — DB var ama geçersiz ise görünür -->
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.RepairDatabaseCommand}"
                                IsEnabled="{x:Bind ViewModel.CanRepair, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.DbExists, Mode=OneWay, Converter={StaticResource TrueToVis}}"
                                Padding="10,6"
                                CornerRadius="{StaticResource MuhasibControlCornerRadius}"
                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="{StaticResource IconWrench}" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="Onar" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Alt özet şerit -->
                <Border
                    CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}"
                    Padding="12,9"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="{x:Bind ViewModel.DbExists, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{StaticResource IconInfo}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.DbExistsMetni, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.IsDbValidMetni, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.DbSize, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        </Grid>
    </StackPanel>
</UserControl>
