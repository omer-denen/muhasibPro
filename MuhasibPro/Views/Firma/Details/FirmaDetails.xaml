<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.Firma.FirmaDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MuhasibPro.Controls"
    xmlns:converters="using:MuhasibPro.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MuhasibPro.ViewModels.ViewModels.Sistem.Firmalar"
    xmlns:views="using:MuhasibPro.Views.Firma"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    Background="{ThemeResource InventEaseBackgroundBrush}">
    <UserControl.Resources>
        <converters:BindingTypeConverter x:Key="BindingTypeConverter" />
        <DataTemplate x:Key="DetailsTemplate" x:DataType="viewmodels:FirmaDetailsViewModel">
            <!-- Form zaten MuhasibCardStyle içinde, iç pill’ler OOBE -->
            <controls:FluidGrid
                controls:ValidationBehavior.Errors="{x:Bind ValidationErrors, Mode=OneWay}"
                ColumnSpacing="12"
                Columns="2"
                RowSpacing="14">
                <Border
                    controls:FluidGrid.ColumnSpan="2"
                    Padding="10,6"
                    CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                    Background="{ThemeResource MuhasibPetrolTintBrush}"
                    BorderBrush="{ThemeResource MuhasibPetrolBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{StaticResource IconBuilding}" FontSize="12" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" />
                        <TextBlock Text="Firma Bilgileri" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" />
                    </StackPanel>
                </Border>
                <controls:FormTextBox
                    controls:ValidationHelper.PropertyName="KisaUnvani"
                    Header="Kısa Ünvan *"
                    Text="{x:Bind EditableItem.KisaUnvani, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <controls:FormTextBox
                    Header="Firma Kodu"
                    IsReadOnly="True"
                    Text="{x:Bind Item.FirmaKodu, Mode=OneWay}"
                    Visibility="{x:Bind ItemIsNew, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                <controls:FormTextBox
                    controls:FluidGrid.ColumnSpan="2"
                    controls:ValidationHelper.PropertyName="TamUnvani"
                    Header="Tam Ünvan"
                    Text="{x:Bind EditableItem.TamUnvani, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <controls:FluidGrid ColumnSpacing="8" Columns="2" MinColumnWidth="120" RowSpacing="12">
                    <controls:FormTextBox controls:ValidationHelper.PropertyName="YetkiliKisi" Header="Yetkili Kişi" Text="{x:Bind EditableItem.YetkiliKisi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:FormTextBox controls:ValidationHelper.PropertyName="Telefon1" DataType="Phone" Header="Telefon" Text="{x:Bind EditableItem.Telefon1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FluidGrid>
                <controls:FluidGrid ColumnSpacing="8" Columns="2" MinColumnWidth="120" RowSpacing="12">
                    <controls:FormTextBox Header="TCK No" Text="{x:Bind EditableItem.TCNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:FormTextBox Header="Para Birimi" Text="{x:Bind EditableItem.PBu1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FluidGrid>

                <Border
                    controls:FluidGrid.ColumnSpan="2"
                    Padding="10,6"
                    CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                    Background="{ThemeResource MuhasibPetrolTintBrush}"
                    BorderBrush="{ThemeResource MuhasibPetrolBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{StaticResource IconHardDrive}" FontSize="12" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" />
                        <TextBlock Text="Adres / Fatura Bilgileri" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" />
                    </StackPanel>
                </Border>

                <controls:FluidGrid ColumnSpacing="8" Columns="2" MinColumnWidth="120" RowSpacing="12">
                    <controls:FormTextBox Header="İl" Text="{x:Bind EditableItem.Il, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:FormTextBox Header="İlçe" Text="{x:Bind EditableItem.Ilce, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FluidGrid>

                <controls:FluidGrid ColumnSpacing="8" Columns="2" MinColumnWidth="120" RowSpacing="12">
                    <controls:FormTextBox DataType="Integer" Header="Posta Kodu" Text="{x:Bind EditableItem.PostaKodu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:FormTextBox Header="Telefon 2" Text="{x:Bind EditableItem.Telefon2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FluidGrid>

                <controls:FormTextBox
                    controls:FluidGrid.ColumnSpan="2"
                    AcceptsReturn="True"
                    Header="Adres"
                    Text="{x:Bind EditableItem.Adres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <controls:FluidGrid ColumnSpacing="8" Columns="2" MinColumnWidth="120" RowSpacing="12">
                    <controls:FormTextBox DataType="Integer" Header="Vergi No" Text="{x:Bind EditableItem.VergiNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:FormTextBox Header="Vergi Dairesi" Text="{x:Bind EditableItem.VergiDairesi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </controls:FluidGrid>
                <controls:FormTextBox Header="E-Posta" Text="{x:Bind EditableItem.Eposta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            </controls:FluidGrid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
        <controls:WindowTitle Title="{x:Bind ViewModel.FirmaDetails.Title, Mode=OneWay, FallbackValue='Yeni Firma'}" Prefix="" />
        <!-- En üst iç border kaldırıldı — başlık artık AppTitleBar'da (geri butonu + Yeni Firma) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <Grid MaxWidth="1160" HorizontalAlignment="Center" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MuhasibCardStyle}" Padding="12" VerticalAlignment="Top">
                    <views:FirmaCard Item="{x:Bind ViewModel.FirmaDetails.Item, Mode=OneWay}" ViewModel="{x:Bind ViewModel.FirmaDetails}" />
                </Border>

                <Border Grid.Column="1" Style="{StaticResource MuhasibCardStyle}" Padding="14" VerticalAlignment="Top">
                    <controls:Details
                        x:Name="details"
                        BackCommand="{x:Bind ViewModel.FirmaDetails.BackCommand}"
                        CanGoBack="{x:Bind ViewModel.FirmaDetails.CanGoBack}"
                        CancelCommand="{x:Bind ViewModel.FirmaDetails.CancelCommand}"
                        DeleteCommand="{x:Bind ViewModel.FirmaDetails.DeleteCommand}"
                        DetailsContent="{x:Bind ViewModel.FirmaDetails}"
                        DetailsTemplate="{StaticResource DetailsTemplate}"
                        EditCommand="{x:Bind ViewModel.FirmaDetails.EditCommand}"
                        IsEditMode="{x:Bind ViewModel.FirmaDetails.IsEditMode, Mode=OneWay}"
                        SaveCommand="{x:Bind ViewModel.FirmaDetails.SaveCommand}" />
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
