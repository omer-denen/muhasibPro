<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.DenetimMasasi.Bolumler.IdentityAyarlarPaneli"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <!-- Güvenlik bölümü (Windows Ayarlar dili): bölüm başlıkları + SettingsCard.
         DataContext = IdentityAyarlarViewModel (sayfa verir; başlık kabukta). -->
    <StackPanel Spacing="24">

        <!-- Giriş Koruması -->
        <StackPanel Spacing="4">
            <TextBlock Text="Giriş Koruması" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,0,0,4" />
            <controls:SettingsCard Description="Bu sayıda yanlış denemeden sonra hesap geçici olarak kilitlenir.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconShield}" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Yanlış deneme sınırı" FontWeight="SemiBold" />
                        <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" ToolTipService.ToolTip="Yalnızca yönetici değiştirebilir" VerticalAlignment="Center">
                            <TextBlock Text="Yönetici" FontSize="10" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                        </Border>
                    </StackPanel>
                </controls:SettingsCard.Header>
                <ComboBox SelectedValue="{Binding MaxFailedAttempts, Mode=TwoWay}" IsEnabled="{Binding IsYonetici, Mode=OneWay}" MinWidth="140">
                    <x:Int32>3</x:Int32>
                    <x:Int32>5</x:Int32>
                    <x:Int32>8</x:Int32>
                    <x:Int32>10</x:Int32>
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Description="Hesap kilitlendiğinde kaç dakika kapalı kalır.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconLock}" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Kilit süresi" FontWeight="SemiBold" />
                        <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" ToolTipService.ToolTip="Yalnızca yönetici değiştirebilir" VerticalAlignment="Center">
                            <TextBlock Text="Yönetici" FontSize="10" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                        </Border>
                    </StackPanel>
                </controls:SettingsCard.Header>
                <ComboBox SelectedValue="{Binding LockoutMinutes, Mode=TwoWay}" IsEnabled="{Binding IsYonetici, Mode=OneWay}" MinWidth="140">
                    <x:Int32>5</x:Int32>
                    <x:Int32>15</x:Int32>
                    <x:Int32>30</x:Int32>
                    <x:Int32>60</x:Int32>
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Description="Yanlış denemelerin sayıldığı süre; bu süre dolunca sayaç sıfırlanır.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconRefresh}" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Deneme penceresi" FontWeight="SemiBold" />
                        <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" ToolTipService.ToolTip="Yalnızca yönetici değiştirebilir" VerticalAlignment="Center">
                            <TextBlock Text="Yönetici" FontSize="10" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                        </Border>
                    </StackPanel>
                </controls:SettingsCard.Header>
                <ComboBox SelectedValue="{Binding AttemptWindowMinutes, Mode=TwoWay}" IsEnabled="{Binding IsYonetici, Mode=OneWay}" MinWidth="140">
                    <x:Int32>5</x:Int32>
                    <x:Int32>15</x:Int32>
                    <x:Int32>30</x:Int32>
                    <x:Int32>60</x:Int32>
                </ComboBox>
            </controls:SettingsCard>
        </StackPanel>

        <!-- Parola -->
        <StackPanel Spacing="4">
            <TextBlock Text="Parola" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,0,0,4" />
            <controls:SettingsCard Description="Yeni parolaların güvenlik gücü. Yüksek değer daha güvenli, kayıtta biraz daha yavaştır.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconZap}" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Parola karma gücü" FontWeight="SemiBold" />
                        <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" ToolTipService.ToolTip="Yalnızca yönetici değiştirebilir" VerticalAlignment="Center">
                            <TextBlock Text="Yönetici" FontSize="10" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                        </Border>
                    </StackPanel>
                </controls:SettingsCard.Header>
                <ComboBox SelectedValue="{Binding Pbkdf2Iterations, Mode=TwoWay}" IsEnabled="{Binding IsYonetici, Mode=OneWay}" MinWidth="140">
                    <x:Int32>50000</x:Int32>
                    <x:Int32>100000</x:Int32>
                    <x:Int32>200000</x:Int32>
                    <x:Int32>500000</x:Int32>
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Header="En az parola uzunluğu" Description="Yeni parolaların kabul edilen en az karakter sayısı.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconUser}" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox SelectedValue="{Binding MinPasswordLength, Mode=TwoWay}" MinWidth="140">
                    <x:Int32>4</x:Int32>
                    <x:Int32>6</x:Int32>
                    <x:Int32>8</x:Int32>
                    <x:Int32>12</x:Int32>
                </ComboBox>
            </controls:SettingsCard>
        </StackPanel>
    </StackPanel>
</UserControl>
