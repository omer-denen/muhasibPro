<UserControl
    x:Class="MuhasibPro.Views.DenetimMasasi.Bolumler.YapayZekaAyarPaneli"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:MuhasibPro.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:StringToVisibilityConverter x:Key="MetinVarsaGoster" />
    </UserControl.Resources>

    <!-- Yapay Zeka (Faz 6.92): Windows Ayarlar dili — bölüm başlıkları + SettingsCard.
         DataContext = YapayZekaAyarlarViewModel (sayfa verir). -->
    <StackPanel x:Name="AyarPaneliKok" Spacing="24">

        <!-- Yükleniyor -->
        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding IsYukleniyor, Converter={StaticResource TrueToVis}}">
            <ProgressRing IsActive="{Binding IsYukleniyor}" Width="20" Height="20" />
            <TextBlock Text="Yükleniyor..." VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Bilgi bandı -->
        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}" Padding="12">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{StaticResource IconInfo}" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Asistan yerel çalışır: veri makineden çıkmaz, kayıt yazmaz. Ayrıntı için ? düğmesine bas." TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="?" Command="{Binding YardimCommand}" Style="{StaticResource CircleIconButtonStyle}" Width="32" Height="32" FontSize="12" ToolTipService.ToolTip="Yardım" />
            </Grid>
        </Border>

        <!-- Durum -->
        <StackPanel Spacing="8">
            <TextBlock Text="Durum" Style="{StaticResource SubtitleTextBlockStyle}" />
            <controls:SettingsCard Header="Sürüm hakkı" Description="{Binding SurumDurumMetni}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconShield}" FontSize="16" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Model" Description="Ürün tarafından sabitlenmiştir (değiştirilemez).">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconDatabase}" FontSize="16" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock Text="{Binding ModelAlias}" VerticalAlignment="Center" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Model durumu" Description="{Binding ModelDurumMetni}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconZap}" FontSize="16" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>
            <controls:SettingsCard Header="Yardım dizini" Description="{Binding DizinDurumMetni}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconDatabase}" FontSize="16" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>
            <TextBlock Text="Model indirme/yükleme, çalışma alanındaki AI Yardım Asistanı panelinden yapılır (statü çubuğu → Asistan)."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="WrapWholeWords" />
        </StackPanel>

        <!-- Model yönetimi (disk) -->
        <StackPanel Spacing="8">
            <TextBlock Text="Model yönetimi" Style="{StaticResource SubtitleTextBlockStyle}" />
            <controls:SettingsExpander
                Header="İndirilmiş modeller"
                Description="{Binding DiskMetni}"
                IsExpanded="True"
                ItemsSource="{Binding Modeller}">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconDatabase}" FontSize="16" />
                </controls:SettingsExpander.HeaderIcon>
                <Button Content="Yenile" Command="{Binding ModelleriYenileCommand}" MinWidth="120" ToolTipService.ToolTip="Listeyi ve disk kullanımını tazele" />
                <controls:SettingsExpander.ItemsHeader>
                    <StackPanel Spacing="6" Padding="0,2,0,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding IsModellerYukleniyor, Converter={StaticResource TrueToVis}}">
                            <ProgressRing IsActive="{Binding IsModellerYukleniyor, Mode=OneWay}" Width="18" Height="18" />
                            <TextBlock Text="Modeller okunuyor..." VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="İndirilmiş model yok. Model, çalışma alanındaki asistan panelinden ilk soruda indirilir."
                                   TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding ModelListesiBosMu, Converter={StaticResource TrueToVis}}" />
                        <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                CornerRadius="{StaticResource ControlCornerRadius}" Padding="10,6"
                                Visibility="{Binding ModellerHataMetni, Converter={StaticResource MetinVarsaGoster}}">
                            <TextBlock Text="{Binding ModellerHataMetni}" TextWrapping="WrapWholeWords" FontSize="12" />
                        </Border>
                    </StackPanel>
                </controls:SettingsExpander.ItemsHeader>
                <controls:SettingsExpander.ItemTemplate>
                    <DataTemplate>
                        <controls:SettingsCard Header="{Binding Baslik}" Description="{Binding BoyutMetni}">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{StaticResource IconDatabase}" FontSize="16" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding YukluMu, Converter={StaticResource TrueToVis}}">
                                    <TextBlock Text="Yüklü" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </Border>
                                <Button Content="Sil" Style="{StaticResource DangerButtonStyle}" MinWidth="120"
                                        Command="{Binding DataContext.ModelSilCommand, ElementName=AyarPaneliKok}"
                                        CommandParameter="{Binding}"
                                        ToolTipService.ToolTip="Modeli diskten sil" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </DataTemplate>
                </controls:SettingsExpander.ItemTemplate>
            </controls:SettingsExpander>
            <TextBlock                        Text="İndirme: çalışma alanında statü çubuğunun sağındaki Asistan düğmesini açıp soru sorun; model ve yürütücü ilk soruda otomatik indirilir, ilerleme panelde görünür. Model ürün tarafından sabitlenmiştir; bu bölümden yalnız disk yönetimi yapılır."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="WrapWholeWords" />
        </StackPanel>

        <!-- Davranış -->
        <StackPanel Spacing="8">
            <TextBlock Text="Davranış" Style="{StaticResource SubtitleTextBlockStyle}" />
            <controls:SettingsCard Header="Asistan etkin" Description="Kapalıysa sohbet paneli kilitli görünür.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconSettings}" FontSize="16" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{Binding EtkinMi, Mode=TwoWay}" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Geçmiş turu" Description="Soruya eklenen konuşma turu (0-20).">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconSettings}" FontSize="16" />
                </controls:SettingsCard.HeaderIcon>
                <NumberBox Value="{Binding MaksGecmisTur, Mode=TwoWay}" Minimum="0" Maximum="20" SpinButtonPlacementMode="Inline" Width="160" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Madde sayısı" Description="Cevaba giren yardım maddesi (1-12).">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconSettings}" FontSize="16" />
                </controls:SettingsCard.HeaderIcon>
                <NumberBox Value="{Binding EnFazlaMadde, Mode=TwoWay}" Minimum="1" Maximum="12" SpinButtonPlacementMode="Inline" Width="160" />
            </controls:SettingsCard>
            <controls:SettingsCard Header="Soru zaman aşımı (sn)" Description="Tek soru için üst süre (10-300).">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconSettings}" FontSize="16" />
                </controls:SettingsCard.HeaderIcon>
                <NumberBox Value="{Binding SoruZamanAsimiSn, Mode=TwoWay}" Minimum="10" Maximum="300" SpinButtonPlacementMode="Inline" Width="160" />
            </controls:SettingsCard>
        </StackPanel>

        <!-- Hata -->
        <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12,8" Visibility="{Binding HataMetni, Converter={StaticResource MetinVarsaGoster}}">
            <TextBlock Text="{Binding HataMetni}" TextWrapping="WrapWholeWords" FontSize="12" />
        </Border>
    </StackPanel>
</UserControl>
