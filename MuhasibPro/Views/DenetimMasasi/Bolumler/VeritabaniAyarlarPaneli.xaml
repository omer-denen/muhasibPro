<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.DenetimMasasi.Bolumler.VeritabaniAyarlarPaneli"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <!-- Veritabanı bölümü (Windows Ayarlar dili): iki SettingsExpander grubu.
         DataContext = DenetimMasasiViewModel; alt VM'lere SistemVeritabani.* / YedekSaklama.* ile bağlanır.
         Grid sarmalayıcı: SettingsExpander/ItemsRepeater + MaxWidth glitch'i (MS notu). -->
    <Grid>
        <StackPanel Spacing="8">

            <!-- Sistem Veritabanı -->
            <controls:SettingsExpander Header="Sistem Veritabanı"
                                       Description="Uygulamanın kendi Sistem.db bağlantı, günlük ve yedek ayarları."
                                       IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconDatabase}" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>

                    <controls:SettingsCard Description="Açılışta alınan Sistem.db tanı yedeklerinden kaç tanesinin saklanacağı. Sınır aşılınca en eski yedek silinir.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{StaticResource IconDatabase}" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Sistem yedeği" FontWeight="SemiBold" />
                                <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" ToolTipService.ToolTip="Yalnızca yönetici değiştirebilir" VerticalAlignment="Center">
                                    <TextBlock Text="Yönetici" FontSize="10" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                </Border>
                            </StackPanel>
                        </controls:SettingsCard.Header>
                        <ComboBox SelectedValue="{Binding SistemVeritabani.SistemKeepLast, Mode=TwoWay}" IsEnabled="{Binding SistemVeritabani.IsYonetici, Mode=OneWay}" MinWidth="140" ToolTipService.ToolTip="Saklanacak sistem yedeği (1-20)">
                            <x:Int32>1</x:Int32>
                            <x:Int32>3</x:Int32>
                            <x:Int32>5</x:Int32>
                            <x:Int32>10</x:Int32>
                            <x:Int32>20</x:Int32>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Veritabanı meşgulken yeni bir işlemin bekleyeceği süre (ms).">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{StaticResource IconLoader}" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Kilit bekleme süresi" FontWeight="SemiBold" />
                                <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" ToolTipService.ToolTip="Yalnızca yönetici değiştirebilir" VerticalAlignment="Center">
                                    <TextBlock Text="Yönetici" FontSize="10" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                </Border>
                            </StackPanel>
                        </controls:SettingsCard.Header>
                        <ComboBox SelectedValue="{Binding SistemVeritabani.BusyTimeoutMs, Mode=TwoWay}" IsEnabled="{Binding SistemVeritabani.IsYonetici, Mode=OneWay}" MinWidth="140" ToolTipService.ToolTip="Kilit bekleme süresi (ms)">
                            <x:Int32>1000</x:Int32>
                            <x:Int32>3000</x:Int32>
                            <x:Int32>5000</x:Int32>
                            <x:Int32>10000</x:Int32>
                            <x:Int32>30000</x:Int32>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="SQLite günlük (journal) modu. Çok kullanıcılı ve dayanıklı çalışma için WAL önerilir.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{StaticResource IconHardDrive}" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Journal modu" FontWeight="SemiBold" />
                                <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" ToolTipService.ToolTip="Yalnızca yönetici değiştirebilir" VerticalAlignment="Center">
                                    <TextBlock Text="Yönetici" FontSize="10" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                </Border>
                            </StackPanel>
                        </controls:SettingsCard.Header>
                        <ComboBox SelectedItem="{Binding SistemVeritabani.JournalMode, Mode=TwoWay}" IsEnabled="{Binding SistemVeritabani.IsYonetici, Mode=OneWay}" MinWidth="140" ToolTipService.ToolTip="Journal modu">
                            <x:String>DELETE</x:String>
                            <x:String>TRUNCATE</x:String>
                            <x:String>PERSIST</x:String>
                            <x:String>MEMORY</x:String>
                            <x:String>WAL</x:String>
                            <x:String>OFF</x:String>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Her yazma işleminde diske ne sıklıkla eşitleneceği. NORMAL dengeli seçenektir.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{StaticResource IconZap}" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Disk senkronizasyonu" FontWeight="SemiBold" />
                                <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" ToolTipService.ToolTip="Yalnızca yönetici değiştirebilir" VerticalAlignment="Center">
                                    <TextBlock Text="Yönetici" FontSize="10" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                </Border>
                            </StackPanel>
                        </controls:SettingsCard.Header>
                        <ComboBox SelectedItem="{Binding SistemVeritabani.Synchronous, Mode=TwoWay}" IsEnabled="{Binding SistemVeritabani.IsYonetici, Mode=OneWay}" MinWidth="140" ToolTipService.ToolTip="Disk senkronizasyonu">
                            <x:String>OFF</x:String>
                            <x:String>NORMAL</x:String>
                            <x:String>FULL</x:String>
                            <x:String>EXTRA</x:String>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Yedek almadan önce veritabanı sıkıştırılsın mı? Daha küçük yedek üretir, işlem biraz uzar.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{StaticResource IconArchive}" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Yedek öncesi VACUUM" FontWeight="SemiBold" />
                                <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" ToolTipService.ToolTip="Yalnızca yönetici değiştirebilir" VerticalAlignment="Center">
                                    <TextBlock Text="Yönetici" FontSize="10" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                </Border>
                            </StackPanel>
                        </controls:SettingsCard.Header>
                        <ToggleSwitch IsOn="{Binding SistemVeritabani.VacuumOnBackup, Mode=TwoWay}" IsEnabled="{Binding SistemVeritabani.IsYonetici, Mode=OneWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- Mali Dönem Veritabanları -->
            <controls:SettingsExpander Header="Mali Dönem Veritabanları"
                                       Description="Firma dönemlerinin SQLite yedeklerinin saklama ve otomatik yedekleme kuralları."
                                       IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="{StaticResource IconBackup}" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>

                    <controls:SettingsCard Description="Kaç manuel yedeğin saklanacağı. Sınır aşılınca en eski yedek silinir (FIFO).">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{StaticResource IconBackup}" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Manuel yedek" FontWeight="SemiBold" />
                                <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" ToolTipService.ToolTip="Yalnızca yönetici değiştirebilir" VerticalAlignment="Center">
                                    <TextBlock Text="Yönetici" FontSize="10" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                </Border>
                            </StackPanel>
                        </controls:SettingsCard.Header>
                        <ComboBox SelectedValue="{Binding YedekSaklama.MaxManuelYedekSayisi, Mode=TwoWay}" IsEnabled="{Binding YedekSaklama.IsYonetici, Mode=OneWay}" MinWidth="140" ToolTipService.ToolTip="Saklanacak manuel yedek adedi (1-20)">
                            <x:Int32>1</x:Int32>
                            <x:Int32>3</x:Int32>
                            <x:Int32>5</x:Int32>
                            <x:Int32>10</x:Int32>
                            <x:Int32>20</x:Int32>
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Description="Sınır aşılınca en eski yedeğin otomatik silinmesi.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{StaticResource IconTrash}" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Otomatik temizleme" FontWeight="SemiBold" />
                                <Border Padding="8,2" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" ToolTipService.ToolTip="Yalnızca yönetici değiştirebilir" VerticalAlignment="Center">
                                    <TextBlock Text="Yönetici" FontSize="10" Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                </Border>
                            </StackPanel>
                        </controls:SettingsCard.Header>
                        <ToggleSwitch IsOn="{Binding YedekSaklama.OtomatikTemizlemeAcik, Mode=TwoWay}" IsEnabled="{Binding YedekSaklama.IsYonetici, Mode=OneWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Kapanışta otomatik yedek" Description="Uygulama kapanırken açık dönemin ve sistem veritabanının yedeği alınsın mı?">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{StaticResource IconLogOut}" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding YedekSaklama.KapanistaOtomatikYedek, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Otomatik yedek aralığı" Description="Sistem yedeğinin kaç günde bir otomatik alınacağı.">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{StaticResource IconCalendar}" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox SelectedValue="{Binding YedekSaklama.WeeklyBackupDays, Mode=TwoWay}" MinWidth="140" ToolTipService.ToolTip="Otomatik yedek aralığı (gün)">
                            <x:Int32>1</x:Int32>
                            <x:Int32>7</x:Int32>
                            <x:Int32>14</x:Int32>
                            <x:Int32>30</x:Int32>
                        </ComboBox>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </Grid>
</UserControl>
