<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.Firmalar.Details.FirmalarDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MuhasibPro.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MuhasibPro.ViewModels.ViewModels.Sistem.Firmalar"
    xmlns:views="using:MuhasibPro.Views.Firmalar.Details"
    d:DesignHeight="600"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="DetailsTemplate" x:DataType="viewmodels:FirmaDetailsViewModel">
            <controls:FluidGrid
                controls:ValidationBehavior.Errors="{x:Bind ValidationErrors, Mode=OneWay}"
                ColumnSpacing="12"
                Columns="2"
                RowSpacing="14">
                <Border
                    controls:FluidGrid.ColumnSpan="2"
                    Padding="10,6"
                    CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                    Background="{ThemeResource MuhasibPetrolTintBrush}"
                    BorderBrush="{ThemeResource MuhasibPetrolBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{StaticResource IconBuilding}" FontSize="12" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" />
                        <TextBlock Text="Firma Bilgileri" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" />
                    </StackPanel>
                </Border>

                <!-- Yalnız gerekli + güncellenebilir alanlar (kimlik/iletişim/fatura) -->
                <controls:FormTextBox
                    controls:ValidationHelper.PropertyName="KisaUnvani"
                    Header="Kısa Ünvan *"
                    Text="{x:Bind EditableItem.KisaUnvani, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <controls:FormTextBox
                    controls:ValidationHelper.PropertyName="YetkiliKisi"
                    Header="Yetkili Kişi *"
                    Text="{x:Bind EditableItem.YetkiliKisi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <controls:FormTextBox
                    controls:FluidGrid.ColumnSpan="2"
                    controls:ValidationHelper.PropertyName="TamUnvani"
                    Header="Tam Ünvan *"
                    Text="{x:Bind EditableItem.TamUnvani, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <controls:FormTextBox
                    controls:ValidationHelper.PropertyName="Telefon1"
                    DataType="Phone"
                    Header="Telefon *"
                    Text="{x:Bind EditableItem.Telefon1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <controls:FormTextBox
                    Header="E-Posta"
                    Text="{x:Bind EditableItem.Eposta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Border
                    controls:FluidGrid.ColumnSpan="2"
                    Padding="10,6"
                    CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                    Background="{ThemeResource MuhasibPetrolTintBrush}"
                    BorderBrush="{ThemeResource MuhasibPetrolBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{StaticResource IconHardDrive}" FontSize="12" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" />
                        <TextBlock Text="Adres / Fatura Bilgileri" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" />
                    </StackPanel>
                </Border>

                <controls:FormTextBox
                    Header="Vergi Dairesi"
                    Text="{x:Bind EditableItem.VergiDairesi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <controls:FormTextBox
                    DataType="Integer"
                    Header="Vergi No"
                    Text="{x:Bind EditableItem.VergiNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <controls:FormTextBox
                    controls:FluidGrid.ColumnSpan="2"
                    AcceptsReturn="True"
                    Header="Adres"
                    Text="{x:Bind EditableItem.Adres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

            </controls:FluidGrid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MuhasibCardStyle}" Padding="12" VerticalAlignment="Top">
                <views:FirmalarCard Item="{x:Bind ViewModel.Item, Mode=OneWay}" ViewModel="{x:Bind ViewModel}" />
            </Border>

            <Border Grid.Column="1" Style="{StaticResource MuhasibCardStyle}" Padding="14" VerticalAlignment="Top">
                <controls:Details
                    x:Name="details"
                    CancelCommand="{x:Bind ViewModel.CancelCommand}"
                    DeleteCommand="{x:Bind ViewModel.DeleteCommand}"
                    DetailsContent="{x:Bind ViewModel}"
                    DetailsTemplate="{StaticResource DetailsTemplate}"
                    EditCommand="{x:Bind ViewModel.EditCommand}"
                    IsEditMode="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                    SaveCommand="{x:Bind ViewModel.SaveCommand}" />
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
