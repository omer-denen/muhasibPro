<Page
    x:Class="MuhasibPro.Views.SistemKurulum.SistemKurulumView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:components="using:MuhasibPro.Views.SistemKurulum.Components"
    xmlns:converters="using:MuhasibPro.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Center" Spacing="16" Padding="32,24,32,28">

                <!-- ===== SAYFA HEADER (frost dışında, zemin üstünde) ===== -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo hapı -->
                    <Border Grid.Column="0" Padding="6,6,16,6" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{StaticResource MuhasibInventCardBrush}" BorderBrush="{StaticResource MuhasibSoftBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="30" Height="30" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{StaticResource MuhasibPetrolBrush}" VerticalAlignment="Center">
                                <TextBlock Text="M" FontSize="16" FontWeight="Bold" Foreground="{StaticResource MuhasibOnPetrolBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="MuhasibPro" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MuhasibTextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Sayfa başlığı -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Sistem Kurulumu" FontSize="11" Foreground="{StaticResource MuhasibSageTertiaryBrush}" />
                        <TextBlock Text="Veritabanı Yapılandırma" FontSize="16" FontWeight="Bold" Foreground="{StaticResource MuhasibTextPrimaryBrush}" />
                    </StackPanel>

                    <!-- Adım göstergesi -->
                    <Border Grid.Column="2" Padding="4" Style="{StaticResource CustomCompactCard}"  VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Border Padding="12,6" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{StaticResource MuhasibInkBrush}">
                                <TextBlock Text="Kurulum" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MuhasibOnInkBrush}" />
                            </Border>
                            <TextBlock Text="Giriş" FontSize="12" Foreground="{StaticResource MuhasibSageTertiaryBrush}" Padding="12,6" VerticalAlignment="Center" />
                            <TextBlock Text="Firma Seçimi" FontSize="12" Foreground="{StaticResource MuhasibSageTertiaryBrush}" Padding="12,6" VerticalAlignment="Center" />
                            <TextBlock Text="Çalışma Alanı" FontSize="12" Foreground="{StaticResource MuhasibSageTertiaryBrush}" Padding="12,6" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== ANA İÇERİK (frost panel) ===== -->
                <Border Style="{StaticResource CustomElevatedCard}">
                    <StackPanel Spacing="10">

                        <!-- Hero kartı (kompakt) -->
                        <Border Style="{StaticResource CustomModernCard}" Padding="0">
                            <Grid Padding="24,18,24,18" ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Padding="8,4" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{StaticResource MuhasibPetrolTintBrush}" BorderBrush="{StaticResource MuhasibPetrolBorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="{StaticResource IconShield}" FontSize="10" Foreground="{StaticResource MuhasibPetrolDeepBrush}"/>
                                                <TextBlock Text="İLK KURULUM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MuhasibPetrolDeepBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="8,4" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{StaticResource MuhasibInventPaleBrush}" BorderBrush="{StaticResource MuhasibSoftBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="Çevrimdışı • SQLite WAL" FontSize="10" Foreground="{StaticResource MuhasibSageTertiaryBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Padding="8,4" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{StaticResource MuhasibInventPaleBrush}" BorderBrush="{StaticResource MuhasibSoftBorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="{StaticResource IconCheckNote}" FontSize="10" Foreground="{StaticResource MuhasibPetrolBrush}"/>
                                                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MuhasibSageSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="MuhasibPro'yu tek adımda başlatın" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MuhasibTextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Global.db otomatik oluşturulur, göçler uygulanır ve bütünlük doğrulanır." FontSize="13" Foreground="{StaticResource MuhasibSageSecondaryBrush}" TextWrapping="Wrap" Opacity="0.95"/>
                                </StackPanel>
                                <!-- Sağ görsel -->
                                <Grid Grid.Column="1" Width="120" Height="120" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse Width="120" Height="120" Fill="{StaticResource MuhasibPetrolTintBrush}" Opacity="0.9"/>
                                    <Ellipse Width="90" Height="90" Fill="{StaticResource MuhasibInventCardBrush}" Stroke="{StaticResource MuhasibSoftBorderBrush}" StrokeThickness="1"/>
                                    <Border Width="60" Height="60" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{StaticResource MuhasibPetrolBrush}">
                                        <FontIcon Glyph="{StaticResource IconDatabase}" FontSize="28" Foreground="{StaticResource MuhasibOnPetrolBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 2 kolon: sol DatabaseInfoPanel | sağ Tests + Log -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <components:DatabaseInfoPanel Grid.Column="0" ViewModel="{x:Bind ViewModel, Mode=OneWay}" VerticalAlignment="Top"/>

                            <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
                                <components:SystemTestsPanel ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                                <components:KurulumKayitPanel ViewModel="{x:Bind ViewModel.KurulumKayit, Mode=OneWay}" />

                                <Border Style="{StaticResource CustomModernCard}" Padding="16">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="{StaticResource MuhasibControlCornerRadius}" Background="{StaticResource MuhasibTerminalBgBrush}"><FontIcon Glyph="{StaticResource IconTerminal}" FontSize="14" Foreground="{StaticResource MuhasibOnPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="İşlem Günlüğü" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource MuhasibTextPrimaryBrush}"/>
                                                <TextBlock Text="Canlı kurulum ve teşhis akışı" FontSize="11" Foreground="{StaticResource MuhasibSageTertiaryBrush}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Padding="8,4" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{StaticResource MuhasibInventPaleBrush}" BorderBrush="{StaticResource MuhasibSoftBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource MuhasibSuccessBrush}"/>
                                                    <TextBlock Text="CANLI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MuhasibSageSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Border Background="{StaticResource MuhasibTerminalBgBrush}" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Padding="12,10" BorderBrush="{StaticResource MuhasibTerminalBorderBrush}" BorderThickness="1">
                                            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
                                                <TextBlock
                                                    Text="{x:Bind ViewModel.LogsText, Mode=OneWay}"
                                                    TextWrapping="Wrap"
                                                    FontFamily="{StaticResource MuhasibMonospaceFontFamily}"
                                                    FontSize="11"
                                                    LineHeight="16"
                                                    Foreground="{StaticResource MuhasibTerminalTextPrimaryBrush}"
                                                    IsTextSelectionEnabled="True" />
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== ALT AKSİYON (frost dışında, zemin üstünde, belirgin) ===== -->
                <Button
                    Command="{x:Bind ViewModel.GoToLoginCommand}"
                    Visibility="{x:Bind ViewModel.IsKurulumTamamlandi, Mode=OneWay, Converter={StaticResource TrueToVis}}"
                    Padding="20,14"
                    HorizontalAlignment="Center"
                    MinWidth="280"
                    Style="{StaticResource MuhasibPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Giriş Ekranına Devam Et" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MuhasibOnInkBrush}" />
                        <FontIcon Glyph="{StaticResource IconChevronRight}" FontSize="14" Foreground="{StaticResource MuhasibOnInkBrush}" />
                    </StackPanel>
                </Button>

                <!-- Sürüm alt bilgi -->
                <TextBlock Text="v1.0 Pro Multi-Tenant" FontSize="11" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" Foreground="{StaticResource MuhasibSageTertiaryBrush}" HorizontalAlignment="Center" Opacity="0.6" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
