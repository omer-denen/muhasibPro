<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MuhasibPro.Views.SistemKurulum.Components.QuickSistemDbDiagDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Kapat"
    SecondaryButtonText="Detaylı Teşhis"
    DefaultButton="None"
    CornerRadius="{StaticResource CardCornerRadius}"
    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    PrimaryButtonStyle="{StaticResource InventDialogPrimaryStyle}"
    SecondaryButtonStyle="{StaticResource InventDialogSecondaryStyle}">

    <ContentDialog.Title>
        <Grid ColumnSpacing="12" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{ThemeResource MuhasibPetrolTintBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="{StaticResource IconWrench}" FontSize="18" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="Hızlı Teşhis" FontSize="10" Foreground="{ThemeResource MuhasibSageTertiaryBrush}" CharacterSpacing="60"/>
                <TextBlock Text="Sistem Veritabanı" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource MuhasibTextPrimaryBrush}"/>
            </StackPanel>
        </Grid>
    </ContentDialog.Title>

    <Border Style="{StaticResource CustomModernCard}" Padding="12">
        <Grid MinWidth="416" MaxWidth="536" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Durum pill -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Border x:Name="StatusPill" Padding="10,4" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource MuhasibSuccessBgBrush}" BorderBrush="{ThemeResource MuhasibSuccessBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="StatusIcon" Glyph="{StaticResource IconCheckCircle}" FontSize="12" Foreground="{ThemeResource MuhasibSuccessBrush}"/>
                    <TextBlock x:Name="StatusText" Text="Hazır" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibSuccessBrush}"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusDetail" Text="Sistem.db • SQLite" FontSize="11" Foreground="{ThemeResource MuhasibSageSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Progress -->
        <ProgressRing x:Name="LoadingRing" Grid.Row="1" Width="24" Height="24" IsActive="True" Foreground="{ThemeResource MuhasibPetrolBrush}" HorizontalAlignment="Left" Visibility="Collapsed"/>

        <!-- Metrikler 2x2 + 1 -->
        <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CustomModernCard}" Padding="12,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource MuhasibInventCardBrush}" BorderBrush="{ThemeResource MuhasibSoftBorderBrush}" BorderThickness="1">
                        <FontIcon Glyph="{StaticResource IconHardDrive}" FontSize="11" Foreground="{ThemeResource MuhasibSageTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="DOSYA" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibSageTertiaryBrush}"/>
                        <TextBlock x:Name="FileExistsText" Text="Var" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibTextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CustomModernCard}" Padding="12,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource MuhasibSuccessBgBrush}">
                        <FontIcon Glyph="{StaticResource IconCheckMark}" FontSize="11" Foreground="{ThemeResource MuhasibSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="BAĞLANTI" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibSageTertiaryBrush}"/>
                        <TextBlock x:Name="CanConnectText" Text="Başarılı" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibSuccessBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CustomModernCard}" Padding="12,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource MuhasibSuccessBgBrush}">
                        <FontIcon Glyph="{StaticResource IconShield}" FontSize="11" Foreground="{ThemeResource MuhasibSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="DOĞRULAMA" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibSageTertiaryBrush}"/>
                        <TextBlock x:Name="ValidText" Text="Geçerli" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibSuccessBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CustomModernCard}" Padding="12,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource MuhasibInventCardBrush}" BorderBrush="{ThemeResource MuhasibSoftBorderBrush}" BorderThickness="1">
                        <FontIcon Glyph="{StaticResource IconPackage}" FontSize="11" Foreground="{ThemeResource MuhasibSageTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="TABLOLAR" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibSageTertiaryBrush}"/>
                        <TextBlock x:Name="TablePendingText" Text="6 / 0" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibTextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CustomModernCard}" Padding="12,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="Mesaj / Sürüm" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibSageTertiaryBrush}"/>
                    <TextBlock x:Name="MessageText" Text="Sistem.db hazır" FontSize="11" Foreground="{ThemeResource MuhasibSageSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="VersionText" FontSize="10" Foreground="{ThemeResource MuhasibSageTertiaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Yedekleme -->
        <Border Grid.Row="3" Style="{StaticResource CustomModernCard}" Padding="14">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{StaticResource IconBackup}" FontSize="14" Foreground="{ThemeResource MuhasibPetrolBrush}"/>
                        <TextBlock Text="Yedekleme" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibTextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="BackupInfoText" Text="Son yedek: — • Toplam: —" FontSize="11" Foreground="{ThemeResource MuhasibSageSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BackupStatusText" FontSize="10" Foreground="{ThemeResource MuhasibSageTertiaryBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BackupButton" Style="{StaticResource MuhasibPrimaryButtonStyle}" Click="OnBackupClick" VerticalAlignment="Center">
                    <Grid>
                        <StackPanel x:Name="BackupButtonContent" Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{StaticResource IconBackup}" FontSize="12" Foreground="{ThemeResource MuhasibOnInkBrush}"/>
                            <TextBlock x:Name="BackupButtonText" Text="Yedek Al" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibOnInkBrush}"/>
                        </StackPanel>
                        <ProgressRing x:Name="BackupRing" Width="16" Height="16" IsActive="False" Foreground="{ThemeResource MuhasibOnInkBrush}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>
        </Grid>
    </Border>
</ContentDialog>
