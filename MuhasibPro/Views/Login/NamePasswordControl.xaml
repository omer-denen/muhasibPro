<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.Login.NamePasswordControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MuhasibPro.Converters"
    xmlns:components="using:MuhasibPro.Views.Components"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:BoolToVisibilityConverter x:Key="FalseToVis" TrueValue="Collapsed" FalseValue="Visible" />
    </UserControl.Resources>

    <StackPanel Spacing="18" MaxWidth="380">

        <!-- Header -->
        <StackPanel Spacing="4">
            <TextBlock
                Text="MuhasibPro sistemine erişmek için kimlik bilgilerinizi giriniz."
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Error Message Inline -->
        <Border
            Padding="12"
            CornerRadius="{StaticResource MuhasibControlCornerRadius}"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
            BorderThickness="1"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource TrueToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon
                    Glyph="{StaticResource IconAlertCircle}"
                    FontSize="16"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Form -->
        <StackPanel Spacing="12">

            <!-- Username -->
            <StackPanel Spacing="6">
                <TextBlock
                    Text="Kullanıcı Adı"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12,4,6,4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            Glyph="{StaticResource IconUser}"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center" />
                        <TextBox
                            Grid.Column="1"
                            x:Name="UsernameTextBox"
                            Padding="2,8,2,8"
                            FontSize="14"
                            BorderThickness="0"
                            PlaceholderText="korkutomer"
                            Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Background="Transparent"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Password -->
            <StackPanel Spacing="6">
                <TextBlock
                    Text="Şifre"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlCornerRadius}" Padding="12,4,6,4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            Glyph="{StaticResource IconLock}"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            VerticalAlignment="Center" />
                        <PasswordBox
                            Grid.Column="1"
                            x:Name="PasswordBox"
                            Padding="2,8,2,8"
                            FontSize="14"
                            BorderThickness="0"
                            PlaceholderText="Şifrenizi giriniz..."
                            Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Background="Transparent"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="2"
                            x:Name="RevealButton"
                            Width="36"
                            Height="36"
                            Style="{StaticResource PlainButtonStyle}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Şifreyi göster / gizle"
                            Click="OnRevealClick">
                            <FontIcon
                                x:Name="RevealIcon"
                                Glyph="{StaticResource IconEye}"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Remember Me & Forgot Password -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    x:Name="RememberMeCheckBox"
                    Grid.Column="0"
                    Content="Beni hatırla"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    IsChecked="{x:Bind ViewModel.IsRememberMe, Mode=TwoWay}"
                    Click="OnRememberMeToggled" />

                <TextBlock
                    Grid.Column="1"
                    Text="Şifremi Unuttum?"
                    FontSize="11"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Beni hatırla animasyonu — checkbox toggle'da satır içi bildirim -->
            <components:AnimatedInfoBorder x:Name="RememberInfoBorder" />

            <!-- Submit Button -->
            <Button
                Height="48"
                HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.LoginWithPasswordCommand}"
                IsEnabled="{x:Bind ViewModel.CanLogin, Mode=OneWay}"
                ToolTipService.ToolTip="Kullanıcı adı ve şifre ile giriş yap">
                <Grid>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <TextBlock Text="Doğrulanıyor..." FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource FalseToVis}}">
                        <TextBlock Text="Sisteme Giriş Yap" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <FontIcon Glyph="{StaticResource IconChevronRight}" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>

        <!-- Demo Hint -->
        <Border
            Style="{StaticResource ModernCard}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    Glyph="{StaticResource IconHelpCircle}"
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                    VerticalAlignment="Center" />
                <TextBlock FontSize="11" Foreground="{ThemeResource SystemFillColorAttentionBrush}" VerticalAlignment="Center">
                    <Run Text="Demo: " /><Run Text="korkutomer / Ok241341" FontWeight="Bold" />
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
