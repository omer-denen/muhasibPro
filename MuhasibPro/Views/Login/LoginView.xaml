<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MuhasibPro.Views.Login.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:login="using:MuhasibPro.Views.Login"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MuhasibPro.Converters"
    mc:Ignorable="d"
    Loaded="OnPageLoaded"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
    </Page.Resources>

    <!-- Kural 17 — Katman 1: kok Border (tema-resimli zemin + ~%87 opak tint). Statik; icerik degisince yeniden olusmaz. -->
    <Border x:Name="KokZemin" CornerRadius="0">
        <Grid>
            <Image Source="{ThemeResource UygulamaZeminGorseli}" Stretch="UniformToFill" />
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.35" />

            <Grid x:Name="RootGrid" Background="Transparent">

                <!-- IsBusy ProgressBar -->
                <ProgressBar Height="3" VerticalAlignment="Top" IsIndeterminate="True"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="Transparent"
                             Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ScrollViewer x:Name="LoginScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <Grid MinHeight="{x:Bind LoginScroll.ViewportHeight, Mode=OneWay}">
                        <!-- Ana border; Kural 13 ? butonu ana border'in sag ust kosesine bagli -->
                        <Grid x:Name="PanelWrap" MaxWidth="1040" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="AnaBorder"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource OverlayCornerRadius}" Padding="24">
                            <Border.Shadow>
                                <ThemeShadow x:Name="AnaBorderShadow" />
                            </Border.Shadow>
                        <StackPanel Spacing="12">

                            <!-- Icerik: genis ekranda SOL bilgi + SAG giris, dar ekranda tek kolon -->
                            <Grid x:Name="IcerikGrid" ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="0.95*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="YerlesimStates">
                                        <VisualState x:Name="WideState">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="820" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="SolPanel.(Grid.Column)" Value="0" />
                                                <Setter Target="SolPanel.(Grid.Row)" Value="0" />
                                                <Setter Target="GirisKarti.(Grid.Column)" Value="1" />
                                                <Setter Target="GirisKarti.(Grid.Row)" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="NarrowState">
                                            <VisualState.StateTriggers>
                                                <AdaptiveTrigger MinWindowWidth="0" />
                                            </VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="SolPanel.(Grid.Column)" Value="0" />
                                                <Setter Target="SolPanel.(Grid.Row)" Value="0" />
                                                <Setter Target="SolPanel.(Grid.ColumnSpan)" Value="2" />
                                                <Setter Target="GirisKarti.(Grid.Column)" Value="0" />
                                                <Setter Target="GirisKarti.(Grid.Row)" Value="1" />
                                                <Setter Target="GirisKarti.(Grid.ColumnSpan)" Value="2" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <!-- SOL: marka + sistem durumu + hizli giris -->
                                <StackPanel x:Name="SolPanel" Grid.Column="0" Grid.Row="0" Spacing="12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Image Width="52" Height="52" Source="ms-appx:///Assets/AppIcon.png" Stretch="Uniform" VerticalAlignment="Center" />
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="MuhasibPro" FontSize="24" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Yeni Nesil Ön Muhasebe" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Adım göstergesi (ince; OOBE yönü) -->
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Kurulum" FontSize="11" Padding="10,4" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <Border Padding="10,4" CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="Giriş" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="Firma Seçimi" FontSize="11" Padding="10,4" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="Çalışma Alanı" FontSize="11" Padding="10,4" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <!-- Sistem durumu -->
                                    <Border Style="{StaticResource ModernCard}" Translation="0,0,32">
                                        <Border.Shadow>
                                            <ThemeShadow x:Name="SistemDurumuShadow" />
                                        </Border.Shadow>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="{StaticResource IconDatabase}" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.DbStatusText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <Border Padding="6,2" CornerRadius="{StaticResource MuhasibControlCornerRadius}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Visibility="{x:Bind ViewModel.DbIsReady, Mode=OneWay}">
                                                        <TextBlock Text="{x:Bind ViewModel.DbStatusPillText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind ViewModel.DbStatusDetail, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="TeshisButton" AutomationProperties.AutomationId="TeshisButton" Style="{StaticResource LinkButtonStyle}" VerticalAlignment="Center" Command="{x:Bind ViewModel.TeshisCommand}"
                                                    ToolTipService.ToolTip="Veritabanı teşhis ve onarımını aç">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="{StaticResource IconWrench}" FontSize="13" />
                                                    <TextBlock Text="Teşhis" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Hizli giris -->
                                    <Border Style="{StaticResource ModernCard}" Translation="0,0,32">
                                        <Border.Shadow>
                                            <ThemeShadow x:Name="HizliGirisShadow" />
                                        </Border.Shadow>
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="HIZLI GİRİŞ" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="80" />
                                            <login:QuickLoginPanel x:Name="QuickLoginPanel" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- SAG: birincil giris karti -->
                                <Border x:Name="GirisKarti" Grid.Column="1" Grid.Row="0" Style="{StaticResource ModernCard}" Padding="20" VerticalAlignment="Center" Translation="0,0,32">
                                    <Border.Shadow>
                                        <ThemeShadow x:Name="GirisKartiShadow" />
                                    </Border.Shadow>
                                    <login:NamePasswordControl x:Name="NamePasswordControl" ViewModel="{x:Bind ViewModel, Mode=OneWay}" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- Sürüm alt bilgisi (metin code-behind'den: AppSurumBilgisi.Metin) -->
                            <TextBlock x:Name="SurumFooter" FontSize="11" FontFamily="{StaticResource MuhasibMonospaceFontFamily}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        </Border>

                        <!-- Kural 13: sayfa yardimi (VM command) — ana border'in sag ust kosesinde -->
                        <Button x:Name="YardimButton" AutomationProperties.AutomationId="YardimButton" Width="36" Height="36" Padding="0" Margin="0,-10,-10,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource CircleIconButtonStyle}" Command="{x:Bind ViewModel.YardimCommand}"
                                ToolTipService.ToolTip="Giriş ekranı hakkında yardım">
                            <FontIcon Glyph="{StaticResource IconHelpCircle}" FontSize="15" />
                        </Button>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Page>
