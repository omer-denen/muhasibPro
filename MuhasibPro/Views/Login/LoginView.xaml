<?xml version="1.0" encoding="utf-8" ?>
    <Page
    x:Class="MuhasibPro.Views.Login.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:login="using:MuhasibPro.Views.Login"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MuhasibPro.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" TrueValue="Visible" FalseValue="Collapsed" />
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <!-- IsBusy ProgressBar -->
        <ProgressBar Height="3" VerticalAlignment="Top" IsIndeterminate="True"
                     Foreground="{StaticResource MuhasibPetrolBrush}" Background="Transparent"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ScrollViewer x:Name="LoginScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Stretch">
            <Grid MinHeight="{x:Bind LoginScroll.ViewportHeight, Mode=OneWay}">
            <StackPanel MaxWidth="1060" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Padding="32,48,32,28">

                <!-- Üst bar (yalnız görüntü: logo + adım hapları, komut yok) -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Padding="10" Style="{StaticResource CustomModernCard}"  BorderThickness="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Image Source="/Assets/AppIcon.png" Height="30" Width="30" />
                            <TextBlock Text="MuhasibPro" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MuhasibTextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="10" Style="{StaticResource CustomModernCard}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="Kurulum" FontSize="12" Foreground="{StaticResource MuhasibSageTertiaryBrush}" Padding="12,6" VerticalAlignment="Center" />
                            <Border Padding="12,6" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{StaticResource MuhasibInkBrush}">
                                <TextBlock Text="Giriş" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MuhasibOnInkBrush}" />
                            </Border>
                            <TextBlock Text="Firma Seçimi" FontSize="12" Foreground="{StaticResource MuhasibSageTertiaryBrush}" Padding="12,6" VerticalAlignment="Center" />
                            <TextBlock Text="Çalışma Alanı" FontSize="12" Foreground="{StaticResource MuhasibSageTertiaryBrush}" Padding="12,6" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- İçerik: TEK buzlu anakart — sol + sağ kartlar üstte yüzer -->
                <Border Style="{StaticResource CustomElevatedCard}" Margin="0" Padding="10">
                    <Grid x:Name="ContentGrid" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="WideState">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="900" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="LeftPanel.(Grid.Column)" Value="0" />
                                        <Setter Target="LeftPanel.(Grid.Row)" Value="0" />
                                        <Setter Target="RightPanel.(Grid.Column)" Value="1" />
                                        <Setter Target="RightPanel.(Grid.Row)" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="NarrowState">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="LeftPanel.(Grid.Column)" Value="0" />
                                        <Setter Target="LeftPanel.(Grid.Row)" Value="0" />
                                        <Setter Target="RightPanel.(Grid.Column)" Value="0" />
                                        <Setter Target="RightPanel.(Grid.Row)" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- SOL: veritabanı + hızlı giriş (saydam iç taşıyıcı — beyazlar buzda yüzer) -->
                        <StackPanel x:Name="LeftPanel" Grid.Column="0" Grid.Row="0" Spacing="12" VerticalAlignment="Top">
                            <TextBlock Text="SİSTEM DURUMU" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MuhasibSageTertiaryBrush}" CharacterSpacing="80" Margin="4,0,0,0" />
                            <Border Style="{StaticResource CustomModernCard}" Padding="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="{StaticResource IconDatabase}" FontSize="13" Foreground="{StaticResource MuhasibSuccessBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.DbStatusText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MuhasibTextPrimaryBrush}" />
                                            <Border Padding="6,2" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{StaticResource MuhasibSuccessBgBrush}" Visibility="{x:Bind ViewModel.DbIsReady, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind ViewModel.DbStatusPillText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MuhasibSuccessBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.DbStatusDetail, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MuhasibSageTertiaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="TeshisButton" Style="{StaticResource LinkButtonStyle}" VerticalAlignment="Center" Click="OnTeshisClicked"
                                            ToolTipService.ToolTip="Veritabanı teşhis ve onarımını aç">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="{StaticResource IconWrench}" FontSize="13" />
                                            <TextBlock Text="Teşhis" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Text="HIZLI GİRİŞ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MuhasibSageTertiaryBrush}" CharacterSpacing="80" Margin="4,4,0,0" />
                                    <login:QuickLoginPanel x:Name="QuickLoginPanel" />
                                
                            </StackPanel>

                        <!-- SAĞ: giriş formu -->
                        <Border x:Name="RightPanel" Grid.Column="1" Grid.Row="0" Style="{StaticResource CustomModernCard}" VerticalAlignment="Top">
                            <login:NamePasswordControl x:Name="NamePasswordControl" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Sürüm alt bilgisi -->
                <TextBlock Text="v1.0 Pro Multi-Tenant" FontSize="11" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" Foreground="{StaticResource MuhasibSageTertiaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
