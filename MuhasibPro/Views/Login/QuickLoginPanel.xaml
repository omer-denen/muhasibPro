<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.Login.QuickLoginPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border        
        Height="Auto"
        VerticalAlignment="Top">
        <StackPanel Spacing="12">
            <!-- Dinamik liste -->
            <ItemsControl x:Name="accountsList" ItemsSource="{x:Bind ViewModel.RememberedAccounts, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Style="{StaticResource ModernCard}">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                    Style="{StaticResource AccountRowButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    ToolTipService.ToolTip="Bu hesapla hızlı giriş yap"
                                    Click="OnAccountClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorAttentionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding RoleName}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Margin="10,0,0,0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource MuhasibControlCornerRadius}" Padding="7,3,7,3" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                <Run Text="@" />
                                                <Run Text="{Binding Username}" />
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Button>
                                <Button Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Style="{StaticResource DismissButtonStyle}"
                                    Margin="0,0,2,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="OnRemoveClick"
                                    ToolTipService.ToolTip="Bu hesabı hızlı giriş listesinden kaldır"
                                    Tag="{Binding}">
                                    <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                x:Name="emptyText"
                FontSize="9"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Henüz hatırlanan hesap yok. 'Beni hatırla' ile ekleyin."
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
