<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MuhasibPro.Views.MaliDonem.MaliDonemYonetimView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:MuhasibPro.Views.MaliDonem.Yonetim.Components"
    xmlns:controls="using:MuhasibPro.Controls"
    xmlns:converters="using:MuhasibPro.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnPageLoaded"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:BoolToVisibilityConverter x:Key="FalseToVis" TrueValue="Collapsed" FalseValue="Visible" />
    </Page.Resources>

    <!-- Kural 17 — Katman 1: kok Border (tema-resimli zemin + ~%87 opak tint). Statik; icerik degisince yeniden olusmaz. -->
    <Border x:Name="KokZemin" CornerRadius="0">
        <Grid>
            <Image Source="{ThemeResource UygulamaZeminGorseli}" Stretch="UniformToFill" />
            <Border Background="{ThemeResource MuhasibZeminPerdeBrush}" />

    <Grid x:Name="RootLayout" RowSpacing="12" Padding="20,16,20,16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1500" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainSplitView.DisplayMode" Value="Inline" />
                        <Setter Target="MainSplitView.IsPaneOpen" Value="True" />
                        <Setter Target="HamburgerButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainSplitView.DisplayMode" Value="Overlay" />
                        <Setter Target="MainSplitView.IsPaneOpen" Value="False" />
                        <Setter Target="HamburgerButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:WindowTitle Title="{x:Bind ViewModel.FirmaBaslik, Mode=OneWay}" />

        <!-- Kural 17 — Katman 2: ana border paneli (tum icerigi cerceveler);
             Kural 13 ? butonu panelin sag ust kosesinde. -->
        <Grid x:Name="PanelWrap" Grid.Row="0" Grid.RowSpan="2">
        <Border x:Name="AnaBorder"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource MuhasibAnaBorderCizgiBrush}" BorderThickness="1.5"
                CornerRadius="{StaticResource OverlayCornerRadius}" Padding="24"
                Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow x:Name="AnaBorderShadow" />
            </Border.Shadow>
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Baslik + firma hapi -->
                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="HamburgerButton" Visibility="Collapsed" Click="OnHamburgerClick" VerticalAlignment="Center" Style="{StaticResource GhostLargeButtonStyle}" ToolTipService.ToolTip="Dönem listesini göster/gizle">
                        <FontIcon Glyph="&#xE700;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Veritabanı &amp; Yedekleme Motoru" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Soldan dönem seçin — sağda işlem kartları açılır." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ProgressRing Width="12" Height="12" IsActive="{Binding IsSayfaYukleniyor, Mode=OneWay}" Foreground="{ThemeResource MuhasibPetrolBrush}" Visibility="{Binding IsSayfaYukleniyor, Mode=OneWay, Converter={StaticResource TrueToVis}}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedFirma.KisaUnvani, FallbackValue='—'}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <Border Padding="7,3" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource MuhasibPetrolTintBrush}" BorderBrush="{ThemeResource MuhasibPetrolBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedFirma.FirmaKodu, FallbackValue='—'}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" />
                        </Border>
                        <Border Padding="7,3" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource MuhasibOliveTintBrush}" BorderBrush="{ThemeResource MuhasibOliveBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibOliveDeepBrush}">
                                <Run Text="{Binding GenelBakisVM.FiltreliDonemler.Count, FallbackValue='0'}" /><Run Text=" dönem" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- KPI seridi -->
                <Border Grid.Row="1" Style="{StaticResource CustomModernCard}" Padding="14,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconDatabase}" FontSize="14" Foreground="{ThemeResource MuhasibPetrolBrush}" VerticalAlignment="Center" />
                            <StackPanel Spacing="0" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                    <Run Text="{Binding GenelBakisVM.FiltreliDonemler.Count, FallbackValue='0'}" /><Run Text=" Dönem DB" />
                                </TextBlock>
                                <TextBlock Text="{Binding GenelBakisVM.KayitliDbAltMetni}" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconHardDrive}" FontSize="14" Foreground="{ThemeResource MuhasibPetrolBrush}" VerticalAlignment="Center" />
                            <StackPanel Spacing="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GenelBakisVM.ToplamDepolamaMetni}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding GenelBakisVM.OrtalamaDepolamaMetni}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconZap}" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                            <StackPanel Spacing="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GenelBakisVM.WalModuMetni}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="Write-Ahead Logging devrede" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconShield}" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                            <StackPanel Spacing="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GenelBakisVM.ButunlukSkoruMetni}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding GenelBakisVM.ButunlukAltMetni}" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Icerik: sol liste + sag kart izgarasi — hamburger responsive -->
                <SplitView x:Name="MainSplitView" Grid.Row="2" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="320" CompactPaneLength="0" PaneBackground="Transparent">
                    <SplitView.Pane>
                        <!-- Sol pane yalnız dönem listesi (sıklık dışı kartlar sağda) -->
                        <Grid Style="{StaticResource CompactElevatedCard}" RowSpacing="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <components:DonemSecimListesi x:Name="DonemSecimListe" />
                            </ScrollViewer>
                        </Grid>
                    </SplitView.Pane>
                    <SplitView.Content>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid ColumnSpacing="12" RowSpacing="12" Style="{StaticResource CompactElevatedCard}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: ozet + toplu — dar ekranda sıkışmaz, satır yatay kayar -->
                            <ScrollViewer Grid.Row="0" Grid.ColumnSpan="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid ColumnSpacing="12" MinWidth="940">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            <!-- Row A sol: birlesik donem karti (hero + bilgi seridi) -->
                            <components:DonemOzetCard x:Name="DonemOzet" Grid.Column="0"
                                                      HizliYedekleClick="OnHizliYedekleClick"
                                                      DonemSilClick="OnDonemSilClick"
                                                      DurumYenileClick="OnDurumYenileClick"
                                                      GuncelleClick="OnGuncelleClick"
                                                      ArsivdenCikarClick="OnArsivdenCikarClick" />

                            <!-- Row A sag: toplu islemler -->
                            <components:TopluIslemlerPanel x:Name="TopluIslemler" Grid.Column="1"
                                                           TopluYedekleClick="OnTopluYedekleClick"
                                                           TopluTestClick="OnTopluTestClick"
                                                           TopluBakimClick="OnTopluBakimClick" />
                            </Grid>
                            </ScrollViewer>

                            <!-- 1. Yedek listesi (en sık) -->
                            <components:DonemYedeklerPanel x:Name="DonemYedekler" Grid.Row="1" Grid.ColumnSpan="2" />

                            <!-- 2. Teknik parametreler (yedek yanında) -->
                            <components:DonemParametrePanel x:Name="DonemParametreler" Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" />

                            <!-- 3. Donem islemleri (4 kutu) -->
                            <components:DonemIslemKartlariPanel x:Name="DonemKartlar" Grid.Row="2" Grid.ColumnSpan="3" />

                            <!-- 4. Analiz dagilimi -->
                            <components:DerinAnalizPanel x:Name="DerinAnalizPanel" Grid.Row="3" Grid.ColumnSpan="3" />

                            <!-- 5. Ayarlar (en seyrek, en altta) -->
                            <Button Grid.Row="4" Grid.ColumnSpan="3" Click="OnAyarlarClick" Style="{StaticResource GhostLargeButtonStyle}" HorizontalAlignment="Right" ToolTipService.ToolTip="Bu firmanın liste ve yedek saklama ayarları">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="{StaticResource IconSettings}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Ayarlar" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                        </Grid>
                        </ScrollViewer>
                    </SplitView.Content>
                </SplitView>

            </Grid>
        </Border>

        <!-- Kural 13: sayfa yardimi (VM command) — ana border'in sag ust kosesinde -->
        <Button x:Name="YardimButton" AutomationProperties.AutomationId="YardimButton" Width="36" Height="36" Padding="0" Margin="0,-10,-10,0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Style="{StaticResource CircleIconButtonStyle}" Command="{x:Bind ViewModel.YardimCommand}"
                ToolTipService.ToolTip="Mali dönem yönetimi hakkında yardım">
            <FontIcon Glyph="{StaticResource IconHelpCircle}" FontSize="15" />
        </Button>
        </Grid>
    </Grid>
        </Grid>
    </Border>
</Page>
