<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.MaliDonem.Yonetim.Components.DonemParametrePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MuhasibPro.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:BoolToVisibilityConverter x:Key="FalseToVis" TrueValue="Collapsed" FalseValue="Visible" />
    </UserControl.Resources>

    <Border Style="{StaticResource CustomModernCard}" Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="DÖNEM VERİTABANI DOSYA &amp; ŞEMA PARAMETRELERİ" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <StackPanel Grid.Row="1" Spacing="8" Margin="0,8,0,0">
                <StackPanel Spacing="1" Padding="12,9" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}">
                    <TextBlock Text="SQLite Format" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                        <Run Text="SQLite " /><Run Text="{Binding DerinAnaliz.SqliteSurumu, FallbackValue='—'}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Spacing="1" Padding="12,9" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}">
                    <TextBlock Text="Page Size" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                        <Run Text="{Binding DerinAnaliz.SayfaBoyutu, FallbackValue='—'}" /><Run Text=" Bytes" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Spacing="1" Padding="12,9" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}">
                    <TextBlock Text="DbContext Modeli" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="AccountingDbContext" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" />
                </StackPanel>
                <StackPanel Spacing="1" Padding="12,9" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}">
                    <TextBlock Text="Migration Durumu" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding SelectedDonem.DbAnaliz.CurrentVersion, FallbackValue='—'}" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="(Güncel)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Visibility="{Binding SelectedDonem.DbGuncellemeGerekliMi, Converter={StaticResource FalseToVis}}" />
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" Visibility="{Binding SelectedDonem.DbGuncellemeGerekliMi, Converter={StaticResource TrueToVis}}">
                            <Run Text="(" /><Run Text="{Binding SelectedDonem.DbBekleyenGuncellemeSayisi}" /><Run Text=" bekleyen)" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
