<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.MaliDonem.Yonetim.Components.ArsivPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MuhasibPro.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
    </UserControl.Resources>

    <StackPanel Spacing="6">
        <TextBlock Text="ARŞİVLENENLER" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibSageTertiaryBrush}" />
        <ItemsControl ItemsSource="{Binding PagedArsivliDonemler}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CustomModernCard}" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Padding="12,8" Margin="0,0,0,6">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibTextPrimaryBrush}">
                                <Run Text="{Binding MaliYil}" /><Run Text=" — " /><Run Text="{Binding DatabaseName}" />
                            </TextBlock>
                            <TextBlock Text="{Binding BoyutMetni}" FontSize="10" Foreground="{ThemeResource MuhasibSageTertiaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Tag="{Binding}" Click="OnGeriAcClick" Style="{StaticResource GhostPillButtonStyle}" ToolTipService.ToolTip="Arşivden Çıkar" VerticalAlignment="Center">
                            <TextBlock Text="Geri Aç" FontSize="10" Foreground="{ThemeResource MuhasibSuccessBrush}" />
                        </Button>
                    </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnSpacing="8" Margin="0,4,0,0" Visibility="{Binding ArsivHasPagination, Converter={StaticResource TrueToVis}, FallbackValue=Collapsed}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="‹" Style="{StaticResource GhostPillButtonStyle}" Click="OnArsivPrevClick" IsEnabled="{Binding ArsivCanPrev}" />
            <TextBlock Grid.Column="1" Text="{Binding ArsivPageInfo}" FontSize="11" Foreground="{ThemeResource MuhasibSageSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="›" Style="{StaticResource GhostPillButtonStyle}" Click="OnArsivNextClick" IsEnabled="{Binding ArsivCanNext}" />
        </Grid>
    </StackPanel>
</UserControl>
