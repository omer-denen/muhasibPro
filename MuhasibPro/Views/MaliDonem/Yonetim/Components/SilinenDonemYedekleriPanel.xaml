<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.MaliDonem.Yonetim.Components.SilinenDonemYedekleriPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MuhasibPro.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:BoolToVisibilityConverter x:Key="FalseToVis" TrueValue="Collapsed" FalseValue="Visible" />
    </UserControl.Resources>

    <StackPanel Spacing="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="SİLİNEN DÖNEM YEDEKLERİ" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                <ProgressRing Width="12" Height="12" IsActive="{Binding IsTaraniyor}" Foreground="{ThemeResource MuhasibPetrolBrush}" Visibility="{Binding IsTaraniyor, Converter={StaticResource TrueToVis}}" />
            </StackPanel>
            <Button ToolTipService.ToolTip="Silinen dönem yedeklerini yeniden tara" Grid.Column="1" Click="OnYenileClick" Style="{StaticResource GhostPillButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="{StaticResource IconRefresh}" FontSize="11" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" />
                    <TextBlock Text="Yenile" FontSize="11" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" />
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock Text="Dönemi silinmiş ama yedeği korunmuş dosyalar." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
        <TextBlock Text="Korunan yedek yok." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Visibility="{Binding IsSilinenBos, Converter={StaticResource TrueToVis}}" />
        <ItemsControl ItemsSource="{Binding PagedSilinenDonemYedekleri}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CustomModernCard}" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Padding="12,8" Margin="0,0,0,6">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BackupFileName}" FontSize="11" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding DatabaseName, FallbackValue='?'}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding BackupFileSizeDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Tag="{Binding}" Click="OnTemizleClick" Style="{StaticResource GhostPillButtonStyle}" ToolTipService.ToolTip="Kalıcı Sil" VerticalAlignment="Center">
                            <TextBlock Text="Temizle" FontSize="10" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </Button>
                    </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnSpacing="8" Margin="0,4,0,0" Visibility="{Binding SilinenHasPagination, Converter={StaticResource TrueToVis}, FallbackValue=Collapsed}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource GhostPillButtonStyle}" Click="OnSilinenPrevClick" IsEnabled="{Binding SilinenCanPrev}" Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTipService.ToolTip="Önceki sayfa">
                <FontIcon Glyph="{StaticResource IconChevronLeft}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <TextBlock Grid.Column="1" Text="{Binding SilinenPageInfo}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button Grid.Column="2" Style="{StaticResource GhostPillButtonStyle}" Click="OnSilinenNextClick" IsEnabled="{Binding SilinenCanNext}" Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTipService.ToolTip="Sonraki sayfa">
                <FontIcon Glyph="{StaticResource IconChevronRight}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
