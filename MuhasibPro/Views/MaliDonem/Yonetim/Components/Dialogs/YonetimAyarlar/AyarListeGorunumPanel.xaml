<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.MaliDonem.Yonetim.Components.Dialogs.YonetimAyarlar.AyarListeGorunumPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Liste ayar grubu: her satır ayrı beyaz kart (DataContext = Liste çocuk VM, dialog verir) -->
    <StackPanel Spacing="10">
        <StackPanel Spacing="4">
            <TextBlock Text="Panel görünümü" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Listeler kaçar kayıtla sayfalansın. Değişiklik anında ve otomatik kaydedilir." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Style="{StaticResource CustomModernCard}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="{StaticResource IconLayers}" FontSize="13" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Firma seçiminde açık dönemler" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="FirmaShellView açıldığında görünen ilk sayfa" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" SelectedValue="{Binding AcikPageSize, Mode=TwoWay}" Width="120" VerticalAlignment="Center" ToolTipService.ToolTip="Sayfa başına açık dönem">
                    <x:Int32>2</x:Int32>
                    <x:Int32>4</x:Int32>
                    <x:Int32>8</x:Int32>
                    <x:Int32>12</x:Int32>
                    <x:Int32>20</x:Int32>
                </ComboBox>
            </Grid>
        </Border>
        <Border Style="{StaticResource CustomModernCard}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="{StaticResource IconLayers}" FontSize="13" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Kapanışta arşive giden dönem sonu yedekleri" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="FirmaShellView'deki Dönem Yedekleri sayfası" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" SelectedValue="{Binding YedekPageSize, Mode=TwoWay}" Width="120" VerticalAlignment="Center" ToolTipService.ToolTip="Sayfa başına dönem yedeği">
                    <x:Int32>2</x:Int32>
                    <x:Int32>4</x:Int32>
                    <x:Int32>8</x:Int32>
                    <x:Int32>12</x:Int32>
                    <x:Int32>20</x:Int32>
                </ComboBox>
            </Grid>
        </Border>
        <Border Style="{StaticResource CustomModernCard}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="{StaticResource IconLayers}" FontSize="13" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Arşive kaldırılan dönemler" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Mali Dönem Yönetimi'ndeki Arşivlenen Dönemler sayfası" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" SelectedValue="{Binding ArsivPageSize, Mode=TwoWay}" Width="120" VerticalAlignment="Center" ToolTipService.ToolTip="Sayfa başına arşivli dönem">
                    <x:Int32>2</x:Int32>
                    <x:Int32>4</x:Int32>
                    <x:Int32>8</x:Int32>
                    <x:Int32>12</x:Int32>
                    <x:Int32>20</x:Int32>
                </ComboBox>
            </Grid>
        </Border>
        <Border Style="{StaticResource CustomModernCard}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="{StaticResource IconLayers}" FontSize="13" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Eşleşmeyen yedek dosyaları" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Yönetim ekranındaki Bilinmeyen Yedekler sayfası" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" SelectedValue="{Binding BilinmeyenPageSize, Mode=TwoWay}" Width="120" VerticalAlignment="Center" ToolTipService.ToolTip="Sayfa başına bilinmeyen yedek">
                    <x:Int32>2</x:Int32>
                    <x:Int32>4</x:Int32>
                    <x:Int32>8</x:Int32>
                    <x:Int32>12</x:Int32>
                    <x:Int32>20</x:Int32>
                </ComboBox>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
