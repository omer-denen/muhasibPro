<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.MaliDonem.Yonetim.Components.Dialogs.YonetimAyarlar.AyarSaklamaPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Yedekleme ayar grubu: her satır ayrı beyaz kart (DataContext = Saklama çocuk VM, dialog verir) -->
    <StackPanel Spacing="10">
        <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Yedekleme" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <Border Padding="7,2" CornerRadius="{StaticResource MuhasibCircleCornerRadius}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MaxManuelYedekSayisi}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
            <TextBlock Text="Yedek sayısı ve otomatik bakım kuralları. Değişiklik anında ve otomatik kaydedilir; kritik satırlar yönetici ister." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Style="{StaticResource CustomModernCard}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="{StaticResource IconBackup}" FontSize="13" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Dönem başına manuel yedek" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="En fazla kaç manuel yedek tutulur (yönetici ayarı)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox Grid.Column="1" SelectedValue="{Binding MaxManuelYedekSayisi, Mode=TwoWay}" Width="120" VerticalAlignment="Center" IsEnabled="{Binding IsYonetici}" ToolTipService.ToolTip="Dönem başına en fazla manuel yedek">
                    <x:Int32>3</x:Int32>
                    <x:Int32>5</x:Int32>
                    <x:Int32>7</x:Int32>
                    <x:Int32>14</x:Int32>
                    <x:Int32>20</x:Int32>
                </ComboBox>
            </Grid>
        </Border>
        <Border Style="{StaticResource CustomModernCard}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="{StaticResource IconTrash}" FontSize="13" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Otomatik temizleme" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Eski yedekler limiti aşınca sessizce silinir" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsOn="{Binding OtomatikTemizlemeAcik, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Style="{StaticResource CustomModernCard}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="{StaticResource IconLogOut}" FontSize="13" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Kapanışta otomatik yedek" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Uygulama kapanırken açık dönemin yedeği alınır" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsOn="{Binding KapanistaOtomatikYedek, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Style="{StaticResource CustomModernCard}" Padding="16,12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="{StaticResource IconShield}" FontSize="13" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Haftalık bütünlük kontrolü" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Bozuk yedek erken yakalansın diye haftada bir doğrulanır" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsOn="{Binding HaftalikButunlukKontrolu, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
