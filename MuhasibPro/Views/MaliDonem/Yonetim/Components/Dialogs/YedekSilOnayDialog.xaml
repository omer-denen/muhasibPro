<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MuhasibPro.Views.MaliDonem.Yonetim.Components.Dialogs.YedekSilOnayDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Kalıcı Sil"
    PrimaryButtonStyle="{StaticResource InventDialogDangerStyle}"
    CloseButtonText="Vazgeç"
    DefaultButton="Close"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="{StaticResource ControlCornerRadius}">

    <ContentDialog.Title>
        <StackPanel Spacing="1">
            <TextBlock Text="Yedek Silme Onayı" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Saklama alt sınırının altına düşeceksiniz" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>
    </ContentDialog.Title>

    <StackPanel Spacing="16" MinWidth="400">
        <Border
            Padding="12"
            CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
            BorderThickness="1">
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap">
                <Run Text="Bu silme sonrası dönem " /><Run x:Name="KalanSayiText" Text="0" FontWeight="Bold" /><Run Text=" yedeğe düşecek (saklama alt sınırı: " /><Run x:Name="AltSinirText" Text="0" FontWeight="Bold" /><Run Text="). Onay için dosya adını aynen yazınız:" />
            </TextBlock>
        </Border>

        <Border
            x:Name="ErrorBorder"
            Padding="10"
            CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
            BorderThickness="1"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ErrorText"
                FontSize="12"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap" />
        </Border>

        <StackPanel Spacing="8">
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                <Run Text="Dosya: " /><Run x:Name="DosyaAdiText" Text="" FontWeight="Bold" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" />
            </TextBlock>
            <TextBox
                x:Name="OnayKutusu"
                PlaceholderText="Dosya adını buraya yazın"
                FontSize="14"
                FontFamily="{StaticResource MuhasibMonospaceFontFamily}"
                Padding="12,10"
                CornerRadius="{StaticResource MuhasibPillCornerRadius}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
