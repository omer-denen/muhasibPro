<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MuhasibPro.Views.MaliDonem.Yonetim.Components.Dialogs.YonetimAyarlarDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ayar="using:MuhasibPro.Views.MaliDonem.Yonetim.Components.Dialogs.YonetimAyarlar"
    xmlns:converters="using:MuhasibPro.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="None"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="{StaticResource ControlCornerRadius}">

    <ContentDialog.Resources>
        <!-- SDK template'i MaxWidth'i temadan alır (640); hamburger+geniş içerik için dialog-içi override (global etkilenmez) -->
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{ThemeResource MuhasibPetrolTintBrush}" BorderBrush="{ThemeResource MuhasibPetrolBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                <FontIcon Glyph="{StaticResource IconSettings}" FontSize="18" Foreground="{ThemeResource MuhasibPetrolDeepBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="AYARLAR" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="60"/>
                <TextBlock Text="{x:Bind ViewModel.FirmaBasligi, Mode=OneWay, FallbackValue='—'}" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{x:Bind ViewModel.KaydedildiMetni, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource MuhasibOliveDeepBrush}" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasKaydedildi, Mode=OneWay, Converter={StaticResource TrueToVis}}" />
                <Button Content="{x:Bind ViewModel.DurumButonMetni, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsOzel, Mode=OneWay}" Click="OnSifirlaClick" Style="{StaticResource GhostPillButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.DurumButonIpucu, Mode=OneWay}" />
            </StackPanel>
                <Button Grid.Column="3" HorizontalAlignment="Right" Width="32" Height="32" Padding="0" Margin="8,0,0,0" Click="OnKapatClick" Style="{StaticResource GhostPillButtonStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="Kapat">
                    <FontIcon Glyph="{StaticResource IconClear}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
        </Grid>
    </ContentDialog.Title>

    <!-- Hamburger menülü gövde: her ayar grubu ayrı UserControl'dedir (YonetimAyarlar/),
         yeni grup = yeni panel + 1 menü satırı, handler değişmez. -->
    <SplitView x:Name="MenuSplit" DisplayMode="CompactInline" IsPaneOpen="True" OpenPaneLength="210" CompactPaneLength="52" PaneBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{StaticResource MuhasibCardCornerRadius}">
        <SplitView.Pane>
            <Grid RowSpacing="8" Padding="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Click="OnHamburgerClick" Style="{StaticResource GhostLargeButtonStyle}" HorizontalAlignment="Left" ToolTipService.ToolTip="Bölüm listesini göster/gizle">
                    <FontIcon Glyph="&#xE700;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
                <ListView Grid.Row="1" x:Name="BolumListe" SelectionChanged="OnBolumSecildi" SelectedIndex="0" SelectionMode="Single">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource MuhasibPetrolTintColor}" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource MuhasibPetrolBorderColor}" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource MuhasibPetrolBorderColor}" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource ControlFillColorSecondary}" />
                        <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="MuhasibPetrolDeepBrush" />
                        <StaticResource x:Key="ListViewItemForegroundSelectedPointerOver" ResourceKey="MuhasibPetrolDeepBrush" />
                    </ListView.Resources>
                    <ListViewItem Tag="GenelPaneli" ToolTipService.ToolTip="Genel">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconBuilding}" FontSize="14" Foreground="{ThemeResource MuhasibPetrolBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Genel" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="ListePaneli" ToolTipService.ToolTip="Panel görünümü">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconLayers}" FontSize="14" Foreground="{ThemeResource MuhasibPetrolBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Panel görünümü" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="SaklamaPaneli" ToolTipService.ToolTip="Yedekleme">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconBackup}" FontSize="14" Foreground="{ThemeResource MuhasibPetrolBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Yedekleme" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Grid>
        </SplitView.Pane>
        <SplitView.Content>
            <ScrollViewer x:Name="IcerikScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="620">
            <StackPanel Spacing="12" MinWidth="620" Padding="8,4,4,4">
                <Grid x:Name="IcerikGrid">
                    <ayar:AyarGenelPanel x:Name="GenelPaneli" />
                    <ayar:AyarListeGorunumPanel x:Name="ListePaneli" Visibility="Collapsed" />
                    <ayar:AyarSaklamaPanel x:Name="SaklamaPaneli" Visibility="Collapsed" />
                </Grid>

                <!-- Çakışma -->
                <Border Padding="12" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.ConflictVar, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.ConflictMetni, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Üzerine Yaz" Click="OnConflictOverwriteClick" Style="{StaticResource PrimaryCompactButtonStyle}" />
                            <Button Content="Vazgeç" Click="OnConflictVazgecClick" Style="{StaticResource GhostPillButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hata -->
                <Border Padding="12" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.HasHata, Mode=OneWay, Converter={StaticResource TrueToVis}}">
                    <TextBlock Text="{x:Bind ViewModel.HataMetni, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            </ScrollViewer>
        </SplitView.Content>
    </SplitView>
</ContentDialog>
