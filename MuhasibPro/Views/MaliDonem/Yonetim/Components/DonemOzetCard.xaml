<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.MaliDonem.Yonetim.Components.DonemOzetCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MuhasibPro.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="TrueToVis" TrueValue="Visible" FalseValue="Collapsed" />
        <converters:BoolToVisibilityConverter x:Key="FalseToVis" TrueValue="Collapsed" FalseValue="Visible" />
        <Storyboard x:Name="ArsivBilgiKaybol">
            <DoubleAnimation Storyboard.TargetName="ArsivBilgiBar" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.6" />
        </Storyboard>
    </UserControl.Resources>

    <Border Style="{StaticResource CustomModernCard}" Padding="16,14">
        <StackPanel Spacing="12">
            <!-- Hero: sol yil+meta, sag aksiyonlar -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedDonem.MaliYil, FallbackValue='—'}" FontSize="34" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Padding="8,3" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1" Visibility="{Binding SelectedDonem.DbGuncelMi, Converter={StaticResource TrueToVis}}">
                                <TextBlock Text="Açık" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            </Border>
                            <Border Padding="8,3" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1" Visibility="{Binding SelectedDonem.DbDosyaYokMu, Converter={StaticResource TrueToVis}}">
                                <TextBlock Text="Dosya Yok" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Border>
                            <Border Padding="8,3" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" Visibility="{Binding SelectedDonem.ArsivliMi, Converter={StaticResource TrueToVis}}">
                                <TextBlock Text="Arşivli" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DonemBaslik}" FontSize="12" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button ToolTipService.ToolTip="Seçili dönemin VACUUM INTO yedeğini al" Click="OnHizliYedekle" Style="{StaticResource PrimaryCompactButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="{StaticResource IconAdd}" FontSize="12" Foreground="{ThemeResource MuhasibOnInkBrush}" />
                            <TextBlock Text="Şimdi Yedekle" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibOnInkBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DonemSilButton" AutomationProperties.Name="Dönemi Sil" Click="OnDonemSil" Style="{StaticResource GhostLargeButtonStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="Dönemi Sil">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="{StaticResource IconTrash}" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="Sil" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.45" />

            <!-- Bilgi seridi: 3 esit kolon -->
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Top">
                    <TextBlock Text="DURUM" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Padding="8,3" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1" VerticalAlignment="Center" Visibility="{Binding SelectedDonem.DbGuncelMi, Converter={StaticResource TrueToVis}}">
                            <TextBlock Text="Güncel" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Padding="8,3" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" VerticalAlignment="Center" Visibility="{Binding SelectedDonem.DbGuncellemeGerekliMi, Converter={StaticResource TrueToVis}}">
                            <TextBlock Text="Güncelleme Gerekli" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Padding="8,3" CornerRadius="{StaticResource MuhasibPillCornerRadius}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" BorderThickness="1" VerticalAlignment="Center" Visibility="{Binding SelectedDonem.DbDosyaYokMu, Converter={StaticResource TrueToVis}}">
                            <TextBlock Text="Dosya Yok" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <Button ToolTipService.ToolTip="PRAGMA bütünlük + dosya analizini yenile" Click="OnDurumYenile" Style="{StaticResource GhostTintOliveButtonStyle}" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <FontIcon Glyph="{StaticResource IconRefresh}" FontSize="12" Foreground="{ThemeResource MuhasibOliveBrush}" />
                            <TextBlock Text="Durumu Yenile" FontSize="12" Foreground="{ThemeResource MuhasibOliveBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                    <TextBlock Text="VERİTABANI" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Grid RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="WAL:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding SelectedDonem.DbWalMetni, FallbackValue='—'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibOliveBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Tablo &amp; Kayıt:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Text="{Binding SelectedDonem.DbTabloKayitMetni, FallbackValue='—'}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Top">
                    <TextBlock Text="YEDEK" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Grid RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Son Yedek:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding SelectedDonem.SonYedekMetni, FallbackValue='—'}" FontSize="12" FontFamily="{StaticResource MuhasibMonospaceFontFamily}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Boyut:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Text="{Binding SelectedDonem.BoyutMetni, FallbackValue='—'}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuhasibOliveBrush}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Uyari barlari -->
            <StackPanel Spacing="8">
                <Grid Padding="12,9" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" Visibility="{Binding SelectedDonem.ArsivliMi, Converter={StaticResource TrueToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bu dönemi kullanmak mı istiyorsunuz? Arşivden çıkararak yeniden aktif hale getirin." FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" ToolTipService.ToolTip="Arşivli dönemi yeniden aktif hale getir" Click="OnArsivdenCikar" Style="{StaticResource GhostPillButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="{StaticResource IconUpload}" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="Arşivden Çıkar" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Visibility="{Binding SelectedDonem.DbDosyaYokMu, Converter={StaticResource TrueToVis}}">
                    <FontIcon Glyph="{StaticResource IconAlertCircle}" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Veritabanı dosyası bulunamadı — aşağıdaki yedek listesinden “Geri Yükle” ile kurtarın ya da Sil ile kaydı temizleyin." FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <Grid x:Name="ArsivBilgiBar" Padding="12,9" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorSuccessBrush}" BorderThickness="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{StaticResource IconCheckCircle}" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ArsivBilgiMetni" Grid.Column="1" Margin="8,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
                <Grid Padding="12,9" CornerRadius="{StaticResource MuhasibCardCornerRadius}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="1" Visibility="{Binding IsDonemSeciliDegil, Converter={StaticResource TrueToVis}}">
                    <TextBlock Text="Dönem seçilemedi — devam etmek için soldaki listeden bir dönem seçin." FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
