<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MuhasibPro.Views.KullaniciYonetimi.Components.KullaniciDuzenlePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <TextBlock
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{Binding Baslik, Mode=OneWay}" />

        <TextBox
            Header="Kullanıcı Adı"
            AutomationProperties.AutomationId="KullaniciAdiKutu"
            IsEnabled="{Binding YeniMi, Mode=OneWay}"
            Text="{Binding KullaniciAdi, Mode=TwoWay}" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Header="Ad" AutomationProperties.AutomationId="AdKutu" Text="{Binding Adi, Mode=TwoWay}" />
            <TextBox Grid.Column="1" Header="Soyad" AutomationProperties.AutomationId="SoyadKutu" Text="{Binding Soyadi, Mode=TwoWay}" />
        </Grid>
        <TextBox Header="E-posta" Text="{Binding Eposta, Mode=TwoWay}" />
        <TextBox Header="Telefon" Text="{Binding Telefon, Mode=TwoWay}" />
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Header="Firma Rolü"
                DisplayMemberPath="RolAdi"
                ItemsSource="{Binding Roller, Mode=OneWay}"
                SelectedItem="{Binding SeciliRol, Mode=TwoWay}" />
            <ToggleSwitch
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Header="Aktif"
                IsOn="{Binding Aktif, Mode=TwoWay}"
                OnContent="Aktif"
                OffContent="Pasif" />
        </Grid>

        <StackPanel Spacing="12" Visibility="{Binding YeniMi, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <PasswordBox
                Header="Şifre"
                AutomationProperties.AutomationId="SifreKutu"
                Password="{Binding Sifre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox
                Header="Şifre Tekrar"
                AutomationProperties.AutomationId="SifreTekrarKutu"
                Password="{Binding SifreTekrar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <InfoBar
            IsClosable="False"
            IsOpen="{Binding HataVar, Mode=OneWay}"
            Message="{Binding HataMetni, Mode=OneWay}"
            Severity="Error" />
    </StackPanel>
</UserControl>
