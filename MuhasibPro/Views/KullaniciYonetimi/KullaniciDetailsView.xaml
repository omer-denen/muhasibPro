<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MuhasibPro.Views.KullaniciYonetimi.KullaniciDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MuhasibPro.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MuhasibPro.Views.KullaniciYonetimi.Details"
    Loaded="OnPageLoaded"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- Kural 17 — Katman 1: kok Border (tema-resimli zemin + perde). Statik. -->
    <Border x:Name="KokZemin" CornerRadius="0">
        <Grid>
            <Image Source="{ThemeResource UygulamaZeminGorseli}" Stretch="UniformToFill" />
            <Border Background="{ThemeResource MuhasibZeminPerdeBrush}" />

            <Grid x:Name="RootLayout" RowSpacing="12" Padding="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:WindowTitle Prefix="Kullanıcı Yönetimi" Title="{x:Bind ViewModel.Title, Mode=OneWay}" />

                <!-- Kural 17 — Katman 2: ana border paneli -->
                <Grid x:Name="PanelWrap" Grid.Row="0" Grid.RowSpan="2">
                    <Border
                        x:Name="AnaBorder"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource MuhasibAnaBorderCizgiBrush}"
                        BorderThickness="1.5"
                        CornerRadius="{StaticResource OverlayCornerRadius}"
                        Padding="24"
                        Translation="0,0,32">
                        <Border.Shadow>
                            <ThemeShadow x:Name="AnaBorderShadow" />
                        </Border.Shadow>

                        <!-- Kural 17 — Katman 3: icerik karti -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="16">
                            <views:KullaniciDetails ViewModel="{x:Bind ViewModel}" />
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>
