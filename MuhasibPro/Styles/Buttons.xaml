        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibPillCornerRadius}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="InventDialogDangerStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibPillCornerRadius}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="InventDialogInfoStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibPillCornerRadius}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  DIALOG CHROME SECONDARY — setters-only (QuickDialog kalibi: "Detayli Teshis" emsali)  -->
    <!--  Chrome Secondary/Close butonlari sablonlu stil almaz; tek kaynak burasi. Sayfada Padding/  -->
    <!--  CornerRadius/Background yazilmaz — olcu/duygu degisimi gerekiyorsa yeni varyant buraya eklenir.  -->
    <Style x:Key="InventDialogSecondaryStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibPillCornerRadius}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ================================================================= -->
    <!-- MERKEZI VARYANTLAR — sayfalarda Button uzerinde Padding/CornerRadius/  -->
    <!-- Background/Foreground/BorderThickness YAZILMAZ. Ihtiyac olan olcu buradan  -->
    <!-- secilir (varyant yoksa base stil aynen kullanilir). Tek kontrol noktasi. -->
    <!-- ================================================================= -->

    <!--  Birincil kompakt (panel CTA'lari: 12,7)  -->
    <Style x:Key="PrimaryCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource InventDarkButtonStyle}">
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <!--  Ikincil kompakt (panel CTA'lari: 12,7)  -->
    <Style x:Key="SecondaryCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <!--  Ghost buyuk (bant/şerit aksiyonlari: 12,7)  -->
    <Style x:Key="GhostLargeButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostPillButtonStyle}">
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <!--  Ghost kucuk (satir ici ikon/metin: 8,5)  -->
    <Style x:Key="GhostSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostPillButtonStyle}">
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <!--  Ghost satir tint'leri (Tumu tablosu Yonet/Yedekle/Durum/Analiz emsali — Small olcu)  -->
    <!--  BorderThickness=0: opak zemin border gerektirmez; 1px border hover'da layout  -->
    <!--  invalidation tetikleyip tooltip timer'ini olduruyordu (Oturum 97 deseni).  -->
    <Style x:Key="GhostTintPaleButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostSmallButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="GhostTintPetrolButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostSmallButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="GhostTintWarningButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostSmallButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="GhostTintInfoButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostSmallButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="GhostTintOliveButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostSmallButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--  DOLU PETROL — kucuk birincil aksiyon (beyaz metin, sablonlu hover/pressed)  -->
