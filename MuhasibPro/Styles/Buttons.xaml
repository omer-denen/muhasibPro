    <!--  Segment (TumuHero 3'lu segment: 10,7 — GhostLarge 12,7'in dar olcusu)  -->
    <Style x:Key="SegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostPillButtonStyle}">
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <!--  Daire ikon (ShellView BackButton 32x32: soluk zemin + soft halka)  -->
