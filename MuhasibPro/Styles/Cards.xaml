<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- MUHASIBPRO KART STILLERI — InventEase Dili                        -->
    <!-- Ana dil: beyaz kart (InventCardStyle), buzlu kap (InventFrost),   -->
    <!-- soluk hap (InventPillMuted), secim karti (RadioButton)            -->
    <!-- ================================================================= -->

    <!--  InventEase ana kart (beyaz, genis radius 24, kilcal kenarlik, flat) — FROST DIŞINDAKİ ANA KARTLAR  -->
    <Style x:Key="InventHeroCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MuhasibInventCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuhasibSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibHeroCornerRadius}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!--  InventEase ic kart (beyaz, orta radius 16, frost panelin icinde) — EkranKaydi referans  -->
    <Style x:Key="InventCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MuhasibInventCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuhasibSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibInventInnerCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!--  InventEase buzlu anakart (acrylic tasiyici, beyaz ic kartlar ustte yuzer)  -->
    <!--  Referans: ic kartlar frost panelin kenarından 16-20px mesafeli (EkranKaydi)  -->
    <Style x:Key="InventFrostPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource InventFrostBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuhasibSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibHeroCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!--  InventEase soluk hap (beyaz kart ici gri hap — kart-icin-kart kurali)  -->
    <Style x:Key="InventPillMutedStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource MuhasibInventPaleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuhasibSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibPillCornerRadius}" />
        <Setter Property="Padding" Value="12,4,12,4" />
    </Style>

    <!--  Yardimci ic kart (alias — InventCardStyle ile ayni)  -->
    <Style x:Key="MuhasibCardStyle" TargetType="Border" BasedOn="{StaticResource InventCardStyle}">
        <Setter Property="Padding" Value="14" />
    </Style>

    <!--  Geriye uyum aliasi (ModernCard = InventHeroCardStyle — 24px ana kart)  -->
    <Style x:Key="ModernCard" TargetType="Border" BasedOn="{StaticResource InventHeroCardStyle}" />

    <!--  Secim karti (RadioButton — yeni palet: CustomModernCard taban, warm reseptif)  -->
    <Style x:Key="MuhasibCardRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="CardBorder"
                            Background="{ThemeResource MuhasibInventPaleBrush}"
                            BorderBrush="{ThemeResource MuhasibSoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}"
                            Padding="0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                 <VisualState x:Name="PointerOver">
                                     <VisualState.Setters>
                                         <Setter Target="HoverOverlay.Opacity" Value="0.30" />
                                     </VisualState.Setters>
                                 </VisualState>
                                 <VisualState x:Name="Pressed">
                                     <VisualState.Setters>
                                         <Setter Target="HoverOverlay.Opacity" Value="0.45" />
                                     </VisualState.Setters>
                                 </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.Background" Value="{ThemeResource MuhasibInventPaleBrush}" />
                                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource MuhasibSoftBorderBrush}" />
                                        <Setter Target="CardBorder.BorderThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CardBorder.Background" Value="{ThemeResource MuhasibPetrolTintBrush}" />
                                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource MuhasibPetrolBrush}" />
                                        <Setter Target="HoverOverlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="HoverOverlay" Background="{ThemeResource MuhasibPetrolTintBrush}" Opacity="0" CornerRadius="{StaticResource MuhasibInventInnerCornerRadius}" IsHitTestVisible="False" />
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="12" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Bolum basligi  -->
    <Style x:Key="ModernSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource MuhasibSageSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!--  Typography (canlı: FormsSection)  -->
    <Style x:Key="FormsSection" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource MuhasibPetrolBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  Info bilesenler (CompactInfoRow + InfoIcon/Label/Value)  -->
    <Style x:Key="CompactInfoRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="InfoIcon" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource MuhasibPetrolBrush}" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="InfoLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource MuhasibSageTertiaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="InfoValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource MuhasibTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!--  Glass Effect Panel (frost aliasi — Details sayfalarinda kullaniliyor)  -->
    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource InventFrostBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuhasibSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibInventInnerCornerRadius}" />
    </Style>

    <!--  Elevated Card (Grid TargetType — FirmalarCard kullanıyor)  -->
    <Style x:Key="ElevatedCard" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource MuhasibInventCardBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibHeroCornerRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BorderBrush" Value="{ThemeResource MuhasibSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!--  Modern Card Styles  -->
    <Style x:Key="CustomModernCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <!--  Compact Modern Card Style  -->
    <Style x:Key="CustomCompactCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <!--  Glass Effect Panel  -->
    <Style x:Key="CustomGlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>
    <Style x:Key="CustomElevatedCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBackgroundFillColorTertiary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Shadow">
            <Setter.Value>
                <ThemeShadow />
            </Setter.Value>
        </Setter>
    </Style>
   
    <!--  Compact Elevated Card  -->
    <Style x:Key="CompactElevatedCard" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CompactPadding}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Shadow">
            <Setter.Value>
                <ThemeShadow />
            </Setter.Value>
        </Setter>
    </Style>
    
    <x:Double x:Key="CardPictureRadius">68</x:Double>
    <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="SmallCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CompactCardCornerRadius">6</CornerRadius>
    <Thickness x:Key="CardPadding">10</Thickness>
    <Thickness x:Key="SectionPadding">16</Thickness>
    <Thickness x:Key="CompactPadding">12</Thickness>
</ResourceDictionary>
