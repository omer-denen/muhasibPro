<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="using:MuhasibPro.Converters">

    <!-- Secim cubugu gorunurlugu — model Selected bayragina bagli (VSM Unselected'a donuste
         Visibility takili kaliyordu; model bayragi SyncSelectedFlags ile her zaman senkron). -->
    <converters:BoolToVisibilityConverter x:Key="MuhasibSelectionTrueToVis" TrueValue="Visible" FalseValue="Collapsed" />

    <!-- ================================================================= -->
    <!-- MUHASIBPRO KART STILLERI — Windows 11 Fluent                      -->
    <!-- Sistem firçalari + ControlCornerRadius/OverlayCornerRadius         -->
    <!-- Ozel stil yalniz Fluent'te karsiligi yoksa tanimlanir.            -->
    <!-- ================================================================= -->

    <!--  Ana kart (Fluent: CardBackground + CardStroke + OverlayCornerRadius)  -->
    <Style x:Key="ModernCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!--  Ic kart (Secondary zemin — kart icinde kart)  -->
    <Style x:Key="InventCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!--  Yardimci kart alias (MuhasibCardStyle = InventCardStyle, kompakt padding)  -->
    <Style x:Key="MuhasibCardStyle" TargetType="Border" BasedOn="{StaticResource InventCardStyle}">
        <Setter Property="Padding" Value="14" />
    </Style>

    <!--  Soluk hap (kart ici bilgi hapi)  -->
    <Style x:Key="InventPillMutedStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MuhasibPillCornerRadius}" />
        <Setter Property="Padding" Value="12,4,12,4" />
    </Style>

    <!--  Secimli liste satiri (ListView ItemContainerStyle — Fluent liste secim dili):
          mavi tam-cerceve YOK. SEÇILI satir ANA KART rengini alir (iceride/çukur
          duruyormus gibi); SECIMSIZ saydamdir → panel yuzeyi. Secim sol accent hub ile.
          Hover secimi ezmez; hover tema-farkinda perde (Light siyah / Dark beyaz).  -->
    <Style x:Key="MuhasibSelectionListItemStyle" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBorder.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBorder.Background" Value="Transparent" />
                                        <Setter Target="ItemBorder.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                        <Setter Target="ItemBorder.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        <Setter Target="HoverOverlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                        <Setter Target="ItemBorder.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        <Setter Target="HoverOverlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                        <Setter Target="ItemBorder.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        <Setter Target="HoverOverlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="HoverOverlay" Background="{ThemeResource MuhasibHoverOverlayBrush}" Opacity="0"
                                    CornerRadius="{StaticResource OverlayCornerRadius}" IsHitTestVisible="False" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SelectionBar" Grid.Column="0" Width="3" Margin="0,10"
                                        CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        VerticalAlignment="Stretch"
                                        Visibility="{Binding Selected, Converter={StaticResource MuhasibSelectionTrueToVis}, FallbackValue=Collapsed}" />
                                <ContentPresenter Grid.Column="1"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="12" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Donem secimli liste satiri — mavi tam-cerceve YOK, animasyon YOK.
          SEÇILI satir ANA KART rengini (CardBackgroundFillColorSecondaryBrush) alir;
          ic panel kartinin uzerine binince iceride/çukur duruyormus gibi gorunur
          (istenen: "orası içerideymiş gibi"). SECIMSIZ satir saydamdir → panel
          yuzeyini gosterir. Secim ayrica sol dikey accent hub ile belli olur.
          Hover secimi ezmez; hover tema-farkinda perde (Light siyah / Dark beyaz).  -->
    <Style x:Key="MuhasibDonemSelectionListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource MuhasibSelectionListItemStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBorder.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBorder.Background" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                        <Setter Target="HoverOverlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                        <Setter Target="HoverOverlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                        <Setter Target="HoverOverlay.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="HoverOverlay" Background="{ThemeResource MuhasibHoverOverlayBrush}" Opacity="0"
                                    CornerRadius="{StaticResource OverlayCornerRadius}" IsHitTestVisible="False" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SelectionBar" Grid.Column="0" Width="3" Margin="0,10"
                                        CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        VerticalAlignment="Stretch"
                                        Visibility="{Binding Content.Selected, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource MuhasibSelectionTrueToVis}, FallbackValue=Collapsed}" />
                                <ContentPresenter Grid.Column="1"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="12" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Bolum basligi (Fluent: SubtitleTextBlockStyle yerine kullanilabilir)  -->
    <Style x:Key="ModernSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!--  Form bolum basligi  -->
    <Style x:Key="FormsSection" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  Info bilesenler  -->
    <Style x:Key="CompactInfoRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="InfoIcon" TargetType="FontIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="InfoLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="InfoValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!-- ================================================================= -->
    <!-- Gecici aliaslar — view turunda kullanim yerlerinde kaldirilacak    -->
    <!-- Tum degerler Fluent sistem firçalarina isaret eder                -->
    <!-- ================================================================= -->

    <!--  CustomModernCard = ModernCard aliasi (view turunda ModernCard'a cevrilecek)  -->
    <Style x:Key="CustomModernCard" TargetType="Border" BasedOn="{StaticResource ModernCard}" />

    <!--  CustomCompactCard (view turunda inline Fluent'e cevrilecek)  -->
    <Style x:Key="CustomCompactCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!--  GlassPanel (view turunda LayerFill'e cevrilecek)  -->
    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>

    <!--  ElevatedCard (Grid TargetType — FirmalarCard kullanıyor)  -->
    <Style x:Key="ElevatedCard" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--  CompactElevatedCard (Grid TargetType — MaliDonemYonetim kullanıyor)  -->
    <Style x:Key="CompactElevatedCard" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
