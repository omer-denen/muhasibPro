<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- MUHASIBPRO DESIGN TOKENS — Windows 11 Fluent                      -->
    <!-- Sistem tema firçalari ({ThemeResource}) oncelikli.                 -->
    <!-- Ozel token YALNIZ Fluent'te karsiligi yoksa tanimlanir.           -->
    <!-- XAML'de RequestedTheme zorlanmaz; tema tek kanal IThemeSelector    -->
    <!-- ================================================================= -->

    <!-- ================= Fluent Uyumluluk Aliaslar (KULLANIMDAN KALDIRILIYOR) ================= -->
    <!-- Login zinciri (Splash/KurulumSplash/SistemDbYonetim/Login) sistem fırçalarına geçti. -->
    <!-- Kalan aliaslar downstream view'ler refactor edilince silinecek — yeni işte KULLANMA.  -->
    <!-- Eski anahtar adlari, Fluent sistem fircalarina yonlendirir.  -->
    <!-- View'ler toplu gecis tamamlaninca silinecek (gecici kopru).   -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Petrol → Accent (gecici alias, view gecisinde AccentFillColor* kullanilacak) -->
            <Color x:Key="MuhasibPetrolColor">#005FB8</Color>
            <Color x:Key="MuhasibPetrolDeepColor">#003D73</Color>
            <Color x:Key="MuhasibPetrolTintColor">#CFE4FA</Color>
            <Color x:Key="MuhasibPetrolBorderColor">#80B8E0</Color>
            <Color x:Key="MuhasibOnPetrolColor">#FFFFFF</Color>

            <!-- Primary = Accent aliasi -->
            <Color x:Key="MuhasibPrimaryColor">#005FB8</Color>
            <Color x:Key="MuhasibPrimaryLightColor">#CFE4FA</Color>
            <Color x:Key="MuhasibPrimaryBorderColor">#80B8E0</Color>
            <Color x:Key="MuhasibOnPrimaryColor">#FFFFFF</Color>

            <!-- Olive → Accent tint (ikinci vurgu kaldirildi, accent varyanti) -->
            <Color x:Key="MuhasibOliveColor">#005FB8</Color>
            <Color x:Key="MuhasibOliveDeepColor">#003D73</Color>
            <Color x:Key="MuhasibOliveTintColor">#CFE4FA</Color>
            <Color x:Key="MuhasibOliveBorderColor">#80B8E0</Color>
            <Color x:Key="MuhasibOnOliveColor">#FFFFFF</Color>

            <!-- Ink → TextFillColorPrimary (standart buton icin) -->
            <Color x:Key="MuhasibInkColor">#1B1B1B</Color>
            <Color x:Key="MuhasibInkHoverColor">#333333</Color>
            <Color x:Key="MuhasibInkPressedColor">#000000</Color>
            <Color x:Key="MuhasibOnInkColor">#FFFFFF</Color>

            <!-- Kural 17: kok zemin gorseli (tema-bazli). Assets/Images/light.jpg -->
            <BitmapImage x:Key="UygulamaZeminGorseli" UriSource="ms-appx:///Assets/Images/light.jpg" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="MuhasibPetrolColor">#60CDFF</Color>
            <Color x:Key="MuhasibPetrolDeepColor">#3BB0E0</Color>
            <Color x:Key="MuhasibPetrolTintColor">#0F3D5C</Color>
            <Color x:Key="MuhasibPetrolBorderColor">#2C7CA8</Color>
            <Color x:Key="MuhasibOnPetrolColor">#000000</Color>

            <Color x:Key="MuhasibPrimaryColor">#60CDFF</Color>
            <Color x:Key="MuhasibPrimaryLightColor">#0F3D5C</Color>
            <Color x:Key="MuhasibPrimaryBorderColor">#2C7CA8</Color>
            <Color x:Key="MuhasibOnPrimaryColor">#000000</Color>

            <Color x:Key="MuhasibOliveColor">#60CDFF</Color>
            <Color x:Key="MuhasibOliveDeepColor">#3BB0E0</Color>
            <Color x:Key="MuhasibOliveTintColor">#0F3D5C</Color>
            <Color x:Key="MuhasibOliveBorderColor">#2C7CA8</Color>
            <Color x:Key="MuhasibOnOliveColor">#000000</Color>

            <Color x:Key="MuhasibInkColor">#FFFFFF</Color>
            <Color x:Key="MuhasibInkHoverColor">#E0E0E0</Color>
            <Color x:Key="MuhasibInkPressedColor">#C0C0C0</Color>
            <Color x:Key="MuhasibOnInkColor">#1B1B1B</Color>

            <!-- Kural 17: kok zemin gorseli (tema-bazli). Assets/Images/dark.jpg -->
            <BitmapImage x:Key="UygulamaZeminGorseli" UriSource="ms-appx:///Assets/Images/dark.jpg" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ================= Terminal (Diagnostics) — koyu panel ================= -->
    <!-- Fluent'te karsiligi yok, bilinçli koyu panel icin korunur -->
    <Color x:Key="MuhasibTerminalBgColor">#0F172A</Color>
    <Color x:Key="MuhasibTerminalBorderColor">#1E293B</Color>
    <Color x:Key="MuhasibTerminalTextPrimaryColor">#CBD5E1</Color>
    <Color x:Key="MuhasibTerminalTextSecondaryColor">#94A3B8</Color>
    <Color x:Key="MuhasibTerminalTextTertiaryColor">#64748B</Color>
    <SolidColorBrush x:Key="MuhasibTerminalBgBrush" Color="{StaticResource MuhasibTerminalBgColor}" />
    <SolidColorBrush x:Key="MuhasibTerminalBorderBrush" Color="{StaticResource MuhasibTerminalBorderColor}" />
    <SolidColorBrush x:Key="MuhasibTerminalTextPrimaryBrush" Color="{StaticResource MuhasibTerminalTextPrimaryColor}" />
    <SolidColorBrush x:Key="MuhasibTerminalTextSecondaryBrush" Color="{StaticResource MuhasibTerminalTextSecondaryColor}" />
    <SolidColorBrush x:Key="MuhasibTerminalTextTertiaryBrush" Color="{StaticResource MuhasibTerminalTextTertiaryColor}" />

    <!-- ================= Gecici alias fircalar (view gecisinde kaldirilacak) ================= -->
    <SolidColorBrush x:Key="MuhasibPetrolBrush" Color="{ThemeResource MuhasibPetrolColor}" />
    <SolidColorBrush x:Key="MuhasibPetrolDeepBrush" Color="{ThemeResource MuhasibPetrolDeepColor}" />
    <SolidColorBrush x:Key="MuhasibPetrolTintBrush" Color="{ThemeResource MuhasibPetrolTintColor}" />
    <SolidColorBrush x:Key="MuhasibPetrolBorderBrush" Color="{ThemeResource MuhasibPetrolBorderColor}" />
    <SolidColorBrush x:Key="MuhasibOnPetrolBrush" Color="{ThemeResource MuhasibOnPetrolColor}" />

    <SolidColorBrush x:Key="MuhasibOliveBrush" Color="{ThemeResource MuhasibOliveColor}" />
    <SolidColorBrush x:Key="MuhasibOliveDeepBrush" Color="{ThemeResource MuhasibOliveDeepColor}" />
    <SolidColorBrush x:Key="MuhasibOliveTintBrush" Color="{ThemeResource MuhasibOliveTintColor}" />
    <SolidColorBrush x:Key="MuhasibOliveBorderBrush" Color="{ThemeResource MuhasibOliveBorderColor}" />
    <SolidColorBrush x:Key="MuhasibOnOliveBrush" Color="{ThemeResource MuhasibOnOliveColor}" />

    <SolidColorBrush x:Key="MuhasibInkBrush" Color="{ThemeResource MuhasibInkColor}" />
    <SolidColorBrush x:Key="MuhasibInkHoverBrush" Color="{ThemeResource MuhasibInkHoverColor}" />
    <SolidColorBrush x:Key="MuhasibInkPressedBrush" Color="{ThemeResource MuhasibInkPressedColor}" />
    <SolidColorBrush x:Key="MuhasibOnInkBrush" Color="{ThemeResource MuhasibOnInkColor}" />

    <SolidColorBrush x:Key="MuhasibPrimaryBrush" Color="{ThemeResource MuhasibPrimaryColor}" />
    <SolidColorBrush x:Key="MuhasibPrimaryLightBrush" Color="{ThemeResource MuhasibPrimaryLightColor}" />
    <SolidColorBrush x:Key="MuhasibPrimaryBorderBrush" Color="{ThemeResource MuhasibPrimaryBorderColor}" />
    <SolidColorBrush x:Key="MuhasibOnPrimaryBrush" Color="{ThemeResource MuhasibOnPrimaryColor}" />

    <!-- Durum — Danger hover/pressed (Buttons.xaml DangerButtonStyle + DismissButtonStyle icin) -->
    <SolidColorBrush x:Key="MuhasibDangerHoverBrush" Color="#A32417" />
    <SolidColorBrush x:Key="MuhasibDangerPressedBrush" Color="#8C1D13" />

    <!-- ================= Kose yaricaplari (Fluent uyumlu) ================= -->
    <!-- Fluent: ControlCornerRadius=4, OverlayCornerRadius=8 -->
    <!-- MuhasibPillCornerRadius korunur (31 dosyada kullaniliyor, Fluent'te pill karsiligi yok) -->
    <CornerRadius x:Key="MuhasibPillCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="MuhasibPanelCornerRadius">8</CornerRadius>

    <!-- Gecici aliaslar — view turunda sistem karsiliklarina cevrilecek -->
    <CornerRadius x:Key="MuhasibControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="MuhasibCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="MuhasibHeroCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="MuhasibInventInnerCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="MuhasibCircleCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="MuhasibAccentCornerRadius">8,0,0,8</CornerRadius>

    <!-- ================= Monospace (Fluent'te karsiligi yok) ================= -->
    <FontFamily x:Key="MuhasibMonospaceFontFamily">Cascadia Code, Consolas, Courier New, monospace</FontFamily>

</ResourceDictionary>
